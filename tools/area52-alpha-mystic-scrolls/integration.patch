+class item_area52_unidentified_mystic final : public ItemScript
+{
+public:
+    item_area52_unidentified_mystic() : ItemScript("item_area52_unidentified_mystic") { }
+
+    bool OnUse(Player* player, Item* item, SpellCastTargets const&) override
+    {
+        if (item->GetEntry() != 97866 || !Applies(player))
+            return false;
+        player->SendEquipError(EQUIP_ERR_NONE, item, nullptr);
+        auto* state = player->CustomData.Get<State>(StateKey);
+        if (!CanChange(player, state) || Data.BySpell.empty())
+            return true;
+        auto chosen = Data.BySpell.begin();
+        std::advance(chosen, urand(0, uint32(Data.BySpell.size() - 1)));
+        uint32 const spell = chosen->first;
+        uint32 const guid = item->GetGUID().GetCounter();
+        uint32 const count = item->GetCount();
+        auto save = CharacterDatabase.BeginTransaction();
+        player->SaveInventoryAndGoldToDB(save);
+        if (!CharacterDatabase.AsyncCommitTransaction(save).m_future.get())
+        {
+            ChatHandler(player->GetSession()).SendSysMessage("Inventory save failed; scroll was not consumed.");
+            return true;
+        }
+        auto transaction = CharacterDatabase.BeginTransaction();
+        if (count > 1)
+            transaction->Append("UPDATE item_instance SET count=count-1 WHERE guid={}", guid);
+        else
+        {
+            transaction->Append("DELETE FROM character_inventory WHERE item={}", guid);
+            transaction->Append("DELETE FROM item_instance WHERE guid={}", guid);
+        }
+        auto* statement = CharacterDatabase.GetPreparedStatement(CHAR_INS_FREEPICK_MYSTIC_COLLECTION);
+        statement->SetData(0, player->GetSession()->GetAccountId());
+        statement->SetData(1, spell);
+        transaction->Append(statement);
+        if (!CharacterDatabase.AsyncCommitTransaction(transaction).m_future.get())
+        {
+            ChatHandler(player->GetSession()).SendSysMessage("Mystic reward failed; scroll was not consumed.");
+            return true;
+        }
+        uint32 consumed = 1;
+        player->DestroyItemCount(item, consumed, true);
+        bool const fresh = state->Known.insert(spell).second;
+        SendKnown(player, *state);
+        ChatHandler(player->GetSession()).PSendSysMessage("Mystic Enchant spell {}: {}.", spell,
+            fresh ? "added to your account collection" : "already collected (duplicate draw)");
+        return true;
+    }
+};
+
+class area52_mystic_scroll_loot final : public GlobalScript
+{
+public:
+    area52_mystic_scroll_loot() : GlobalScript("area52_mystic_scroll_loot", {GLOBALHOOK_ON_ITEM_ROLL}) { }
+
+    bool OnItemRoll(Player const* player, LootStoreItem const* item, float& chance,
+        Loot&, LootStore const& store) override
+    {
+        if (item->itemid != 97866 || &store != &LootTemplates_Creature)
+            return true;
+        float const rate = std::clamp(sConfigMgr->GetOption<float>("CoA.FreePickMysticEnchants.ScrollDropChance", 25.0f), 0.0f, 100.0f);
+        chance = 100.0f;
+        return Applies(player) && roll_chance_f(rate);
+    }
+};
