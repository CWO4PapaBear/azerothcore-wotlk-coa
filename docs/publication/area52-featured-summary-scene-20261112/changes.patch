+        auto a=row.find(':'), b=row.find(':',a==row.npos?a:a+1);
+        unsigned spell=0,level=0;
+        if (a==row.npos || b==row.npos || !SummaryNumber(row.substr(0,a),spell) ||
+            !SummaryNumber(row.substr(a+1,b-a-1),level) || level>80) return false;
