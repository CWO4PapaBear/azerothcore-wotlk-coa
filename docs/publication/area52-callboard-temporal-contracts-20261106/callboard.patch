+
+    [[nodiscard]] bool OnPlayerQuestGiverChooseReward(Player* player, Object*, Quest const* quest, uint32) override
+    {
+        std::optional<std::string> const exhausted = ExhaustedContractName(player, quest);
+        if (!exhausted)
+            return false;
