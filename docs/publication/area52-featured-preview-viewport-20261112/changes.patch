+-- Model widgets use screen-space viewports on this client. Keep the model
+-- outside the scroll child and give it only the visible part of its layout slot.
+local function attachPreviewModel(view, section, slot, kind)
+    local scroll=view.MainFrame.ScrollFrame
+    local model=CreateFrame(kind,nil,scroll)
+    local last={}
+    local function sync()
+        if not section:IsVisible() or not slot:IsVisible() then model:Hide();return end
+        local l,b,w,h=slot:GetLeft(),slot:GetBottom(),slot:GetWidth(),slot:GetHeight()
+        local x,y,sw,sh=scroll:GetLeft(),scroll:GetBottom(),scroll:GetWidth(),scroll:GetHeight()
+        if not (l and b and w and h and x and y and sw and sh) then model:Hide();return end
+        local ratio=slot:GetEffectiveScale()/scroll:GetEffectiveScale()
+        local left=math.max(0,l*ratio-x)
+        local right=math.min(sw,(l+w)*ratio-x)
+        local bottom=math.max(0,b*ratio-y)
+        local top=math.min(sh,(b+h)*ratio-y)
+        if right<=left or top<=bottom then model:Hide();return end
+        local width,height=right-left,top-bottom
+        if last.x~=left or last.y~=bottom or last.w~=width or last.h~=height then
+            model:ClearAllPoints();model:SetPoint("BOTTOMLEFT",scroll,"BOTTOMLEFT",left,bottom)
+            model:SetSize(width,height)
+            last.x,last.y,last.w,last.h=left,bottom,width,height
+        end
+        model:Show()
+    end
+    section:HookScript("OnUpdate",sync)
+    section:HookScript("OnHide",function()model:Hide()end)
+    slot:HookScript("OnHide",function()model:Hide()end)
+    model:Hide()
+    return model
+end
