+-- The spell menus can contain every spell in a build. Keep a fixed pool of
+-- rows in a picker parented to the editor instead of expanding a native menu.
+local function castSelector(view,parent,index,title)
+    local button=CreateFrame("Button",nil,parent,"UIPanelButtonTemplate")
+    button:SetSize(212,24)
+    button:SetPoint("TOPLEFT",parent,"TOPLEFT",309,-46-(index-1)*60)
+    local function open()
+        local picker=view.CastVisualPicker
+        if not picker then
+            picker=CreateFrame("Frame",nil,view)
+            view.CastVisualPicker=picker
+            picker:SetPoint("CENTER",view,"CENTER",0,0)
+            picker:SetFrameStrata("DIALOG");picker:EnableMouse(true)
+            picker:SetBackdrop({bgFile="Interface\\Buttons\\WHITE8X8",edgeFile="Interface\\Tooltips\\UI-Tooltip-Border",edgeSize=14})
+            picker:SetBackdropColor(0.055,0.045,0.035,1)
+            picker.heading=picker:CreateFontString(nil,"OVERLAY","GameFontNormal")
+            picker.heading:SetPoint("TOPLEFT",16,-12)
+            local close=CreateFrame("Button",nil,picker,"UIPanelCloseButton")
+            close:SetPoint("TOPRIGHT",-2,-2);close:SetScript("OnClick",function()picker:Hide()end)
+            picker.rows={}
+            local function draw(value)
+                picker.first=math.max(1,math.min(picker.maximum,math.floor(value+0.5)))
+                for i,row in ipairs(picker.rows) do
+                    local entry=picker.options[picker.first+i-1]
+                    row:SetShown(i<=picker.count and entry~=nil)
+                    if entry and i<=picker.count then
+                        row:SetText((entry.id==picker.selected and "|cffffd100" or "")..entry.name..(entry.id==picker.selected and "|r" or ""))
+                    end
+                end
+            end
+            for i=1,12 do
+                local offset=i-1
+                local row=CreateFrame("Button",nil,picker,"UIPanelButtonTemplate")
+                row:SetHeight(22)
+                row:SetPoint("TOPLEFT",12,-36-offset*23);row:SetPoint("TOPRIGHT",-36,-36-offset*23)
+                row:SetScript("OnClick",function()
+                    local choice=picker.options[picker.first+offset]
+                    local callback=picker.callback
+                    picker:Hide()
+                    if choice and callback then callback(choice.id) end
+                end)
+                picker.rows[i]=row
+            end
+            local slider=CreateFrame("Slider",view:GetName().."CastVisualScrollBar",picker,"UIPanelScrollBarTemplate")
+            slider:SetPoint("TOPRIGHT",-12,-52);slider:SetPoint("BOTTOMRIGHT",-12,25)
+            slider:SetValueStep(1);slider:SetScript("OnValueChanged",function(_,value)
+                if picker.options then draw(value) end
+            end)
+            picker.slider=slider
+            picker:EnableMouseWheel(true)
+            picker:SetScript("OnMouseWheel",function(_,delta)
+                slider:SetValue(math.max(1,math.min(picker.maximum,picker.first-delta*3)))
+            end)
+            picker.draw=draw
+            view:HookScript("OnHide",function()picker:Hide()end)
+            view:HookScript("OnSizeChanged",function()picker:Hide()end)
+        end
+        if not F.Applies() or not button.options then return end
+        picker.options=button.options;picker.selected=button.selected;picker.callback=button.callback
+        picker.generation=view.Area52FeaturedGeneration;picker.archetype=view.Area52ArchetypeID
+        local width=math.min(340,view:GetWidth()-16)
+        local count=math.min(12,#picker.options,math.floor((view:GetHeight()-68)/23))
+        if width<80 or count<1 then picker:Hide();return end
+        picker.count=count;picker.maximum=math.max(1,#picker.options-count+1)
+        picker:SetSize(width,48+count*23);picker.heading:SetText(title)
+        local first=1
+        for i,entry in ipairs(picker.options) do if entry.id==picker.selected then first=math.min(i,picker.maximum);break end end
+        picker.slider:SetMinMaxValues(1,picker.maximum);picker.slider:SetValue(first)
+        picker.slider:SetShown(picker.maximum>1);picker.draw(first);picker:Show()
+    end
+    button:SetScript("OnClick",open)
+    function button:SetCastChoices(choices,current,callback)
+        self.options=choices;self.selected=current;self.callback=callback
+        local text=tostring(current)
+        for _,entry in ipairs(choices)do if entry.id==current then text=entry.name;break end end
+        self:SetText(text.."  |TInterface\\ChatFrame\\UI-ChatIcon-ScrollDown-Up:14|t")
+        local picker=view.CastVisualPicker
+        if picker and (picker.generation~=view.Area52FeaturedGeneration or picker.archetype~=view.Area52ArchetypeID) then picker:Hide() end
+    end
+    return button
+end
