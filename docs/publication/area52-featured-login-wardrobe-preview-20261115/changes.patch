+
+    void RestoreMailedMilestoneUnlocks(Player* player)
+    {
+        auto* session = player->GetSession();
+        auto guid = player->GetGUID();
+        std::string query = "SELECT DISTINCT i.itemEntry FROM area52_featured_milestones f "
+            "JOIN mail m ON m.id=f.mail_id AND m.receiver=f.guid "
+            "JOIN mail_items a ON a.mail_id=m.id AND a.receiver=f.guid "
+            "JOIN item_instance i ON i.guid=a.item_guid WHERE f.guid=" + std::to_string(guid.GetCounter());
+        session->GetQueryProcessor().AddCallback(CharacterDatabase.AsyncQuery(query).WithCallback(
+            [this,session,guid](QueryResult rows)
+            {
+                Player* owner = session->GetPlayer();
+                if (!rows || !owner || owner->GetGUID()!=guid)
+                    return;
+                Area52MilestoneCollection collection;
+                auto transaction = CharacterDatabase.BeginTransaction();
+                do
+                    AppendMilestoneUnlock(owner, rows->Fetch()[0].Get<uint32>(), transaction, collection);
+                while (rows->NextRow());
+                if (collection.Items.empty() && collection.Appearances.empty())
+                    return;
+                session->AddTransactionCallback(CharacterDatabase.AsyncCommitTransaction(transaction)).AfterComplete(
+                    [this,session,guid,collection](bool success)
+                    {
+                        auto* current = session->GetPlayer();
+                        if (success && current && current->GetGUID()==guid)
+                            ConfirmMilestoneUnlock(current, collection);
+                    });
+            }));
+    }
+
+    void AppendMilestoneUnlock(Player* player, uint32 item, CharacterDatabaseTransaction& transaction, Area52MilestoneCollection& collection)
+    {
+        auto account = player->GetSession()->GetAccountId();
+        if (auto it = _itemAppearances.find(item); it != _itemAppearances.end() && _appearances.contains(it->second))
+        {
+            transaction->Append("INSERT IGNORE INTO account_appearance_collection (account_id,appearance_id,source_item) VALUES ({},{},{})", account, it->second, item);
+            collection.Appearances.emplace_back(it->second, item);
+        }
+        if (auto it = _vanityItems.find(item); it != _vanityItems.end() && !IsConsumableVanityItem(it->second))
+        {
+            transaction->Append("INSERT IGNORE INTO account_vanity_collection (account_id,item_id) VALUES ({},{})", account, item);
+            collection.Items.push_back(item);
+        }
+    }
+    void ConfirmMilestoneUnlock(Player* player, Area52MilestoneCollection const& collection)
+    {
+        if (auto state = GetState(player))
+        {
+            for (auto [appearance,item] : collection.Appearances)
+                if (state->CollectedAppearances.insert(appearance).second)
+                    SendAppearanceAdded(player, appearance, item);
+            for (auto item : collection.Items)
+                if (state->OwnedVanityItems.insert(item).second)
+                    SendVanityCollectionAdded(player,item);
+        }
     }
 
