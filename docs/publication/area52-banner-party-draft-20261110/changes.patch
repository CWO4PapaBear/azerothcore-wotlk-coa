+static void MatchPartyLeader(Player* leader)
+{
+    if (!leader || !leader->IsInWorld() || !leader->IsAlive() || leader->IsInCombat() ||
+        leader->duel || leader->IsInFlight() || leader->IsBeingTeleported() ||
+        leader->InBattleground() || leader->InBattlegroundQueue() || sRandomPlayerbotMgr.IsRandomBot(leader))
+        return;
+    Group* group=leader->GetGroup();
+    if (!group || group->isRaidGroup() || group->GetLeaderGUID()!=leader->GetGUID()) return;
+    for (GroupReference* ref=group->GetFirstMember();ref;ref=ref->next())
+    {
+        Player* bot=ref->GetSource();
+        if (!bot || bot==leader || !IsPilot(bot) || !PartyBotNeedsProgress(bot,leader->GetLevel()) ||
+            !bot->IsInWorld() || !bot->IsAlive() || bot->GetMap()!=leader->GetMap() ||
+            bot->IsInCombat() || bot->duel || bot->IsInFlight() || bot->IsBeingTeleported() ||
+            bot->InBattleground() || bot->InBattlegroundQueue() || bot->IsNonMeleeSpellCast(false)) continue;
+        std::string error;
+        if (!AdvanceCoaPartyBot(bot,leader->GetLevel(),error) && !error.empty())
+            LOG_DEBUG("playerbots","Party level sync for {} at {}: {}",bot->GetName(),leader->GetLevel(),error);
+    }
+}
