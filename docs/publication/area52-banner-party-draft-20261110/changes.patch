+bool PartyBotNeedsProgress(Player const* bot,uint32 leaderLevel)
+{
+    if (!bot || bot->GetLevel()>leaderLevel) return false;
+
+    std::lock_guard<std::mutex> guard(StatesLock);
+    auto it=States.find(bot->GetGUID().GetRawValue());
+    return it!=States.end() && it->second.usesFeaturedSlots &&
+        (bot->GetLevel()<leaderLevel || it->second.appliedLevel!=leaderLevel);
+}
+
+bool AdvanceCoaPartyBot(Player* bot, uint32 level, std::string& error)
+{
+#if COA_LEGENDARY_CLASSES
+    auto profile=CoaDungeonPool::ProfileFor(bot);
+    auto group=bot ? bot->GetGroup() : nullptr;
+    if (!profile || !group || !CoaDungeonPool::IsPilot(bot) || level<bot->GetLevel() ||
+        level>sWorld->getIntConfig(CONFIG_MAX_PLAYER_LEVEL)) return false;
+
+    Area52Build::Entry plan;
+    if (!ReadPilotPlan(SavedRevision(bot,profile->archetype),profile->legendary,plan,error))
+        return false;
+    static AscensionFreePick::Catalog catalog; // World update thread; retain the successfully loaded static DBC data.
+    if (catalog.Entries.empty())
+    {
+        AscensionFreePick::Catalog loaded;
+        if (!AscensionFreePick::LoadCatalog(loaded)) {error="Free Pick catalog unavailable";return false;}
+        catalog=std::move(loaded);
+    }
+    std::vector<AscensionFreePick::KnownEntry> wanted;
+    auto planned=Area52Build::Select(catalog,plan,level,wanted,AscensionFreePick::KnownEntries(bot));
+    if (!planned) {error=std::string(planned.Status)+" "+planned.Learn;return false;}
+    if (bot->GetLevel()<level) bot->GiveLevel(level);
+    if (bot->GetLevel()!=level) {error="level change declined";return false;}
+    auto applied=AscensionFreePick::Apply(bot,wanted,false);
+    if (!applied)
+    {
+        // The existing level-restoration path retries the pinned build on a subsequent safe update.
+        error=std::string(applied.Status)+" "+applied.Learn;
+        return false;
+    }
+    auto build=FindCoaLegendaryClass(std::string(profile->spec));
+    if (build) RemoveUnpickedSpells(bot,*build);
+    {
+        std::lock_guard<std::mutex> guard(StatesLock);
+        auto& state=States[bot->GetGUID().GetRawValue()];
+        if(state.usesFeaturedSlots) state.appliedLevel=level;
+    }
+    bot->SaveToDB(false,false);
+    return true;
+#else
+    error="Free Pick unavailable";return false;
+#endif
+}
