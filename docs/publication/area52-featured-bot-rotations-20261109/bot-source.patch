+bool ApplyCoaFeaturedRevision(Player* bot, CoaLegendaryClass const& build, CoaFeaturedRevision revision,std::string& error)
+{
+#if COA_LEGENDARY_CLASSES
+    if (!CoaDungeonPool::IsPilot(bot) || RandomClassFor(bot)!=&build) {error="pilot assignment mismatch";return false;}
+    if (!AscensionMysticEnchant::DraftEquipmentReady(bot)) {error="bot enchant state still loading";return false;}
+    auto profile=Area52PilotProfiles::Find(build.legendary);
+    if (!profile) {error="profile not registered";return false;}
+    auto saved=SavedRevision(bot,profile->archetype);
+    Area52Build::Entry plan;
+    std::vector<AscensionFreePick::KnownEntry> wanted;
+    if (!ValidatePilotPlan(bot,build,revision,plan,wanted,error))
+    {
+        // Worldserver log is available to GMs investigating a failed recruitment.
+        static std::mutex reportLock;
+        static std::map<std::pair<unsigned,unsigned>,std::pair<CoaFeaturedRevision,std::string>> reported;
+        {
+            std::lock_guard<std::mutex> guard(reportLock);
+            auto& last=reported[{profile->archetype,bot->GetLevel()}];
+            auto issue=std::make_pair(revision,error);
+            if (last!=issue)
+            {
+                LOG_ERROR("playerbots","Featured {} build {} revision {} at level {}: {} (last accepted {}:{})",
+                    build.name,revision.first,revision.second,bot->GetLevel(),error,saved.first,saved.second);
+                std::ostringstream notice;
+                notice << "Bot " << build.name << ", Featured build " << revision.first
+                       << " revision " << revision.second << ", level " << unsigned(bot->GetLevel()) << ": " << error;
+                ChatHandler(bot->GetSession()).SendGlobalGMSysMessage(notice.str().c_str());
+                last=issue;
+            }
+        }
+        if (!saved.first || saved==revision || !ValidatePilotPlan(bot,build,saved,plan,wanted,error)) return false;
+        revision=saved;
+    }
+    auto previous=GetCoaLegendaryClass(bot);
+    auto priorSelection=AscensionFreePick::KnownEntries(bot);
+    auto applied=AscensionFreePick::Apply(bot,wanted,false);
+    if (!applied) {error=std::string(applied.Status)+" "+applied.Learn;return false;}
+    std::vector<Area52Build::Enchant> priorEnchants;
+    if (auto previousSlots=bot->FindPlayerSettings(SlotSetting(bot)))
+        for(size_t i=0;i<17 && i<previousSlots->size();++i)
+            if(auto id=(*previousSlots)[i].value)
+            {
+                auto entry=std::find_if(priorEnchants.begin(),priorEnchants.end(),
+                    [id](auto const& enchant){return enchant.Id==id;});
+                if(entry==priorEnchants.end())
+                {
+                    Area52Build::Enchant enchant;
+                    enchant.Id=id;enchant.Stacks=1;priorEnchants.push_back(enchant);
+                }
+                else ++entry->Stacks;
+            }
+    if (!AscensionMysticEnchant::ApplyDraftEnchants(bot,plan.Enchants))
+    {
+        auto restored=AscensionFreePick::Apply(bot,priorSelection,false);
+        error=restored ? "could not apply validated Featured enchants; previous picks restored" :
+            "Featured enchant apply and previous pick restoration failed";
+        return false;
+    }
+
+    auto slots=bot->FindPlayerSettings(SlotSetting(bot));
+
+    std::multiset<uint32> expected,actual;
+    for(auto const& enchant:plan.Enchants)
+        for(unsigned i=0;i<enchant.Stacks;++i) expected.insert(enchant.Id);
+    for(unsigned i=0;slots && i<17 && i<slots->size();++i)
+        if((*slots)[i].value) actual.insert((*slots)[i].value);
+    if(!slots || !bot->HasAura(build.legendary) || actual!=expected)
+    {
+        bool restoredSlots=AscensionMysticEnchant::ApplyDraftEnchants(bot,priorEnchants);
+        auto restoredPicks=AscensionFreePick::Apply(bot,priorSelection,false);
+        error=restoredSlots && restoredPicks ? "Featured effect readback failed; previous build restored" :
+            "Featured effect readback failed; previous build restoration incomplete";
+        return false;
+    }
+    RemoveUnpickedSpells(bot,build);
+    if(previous && previous!=&build) LeaveClass(bot,*previous,build);
+    if(revision!=saved)
+    {
+        auto key=PinKey(profile->archetype);
+        bot->UpdatePlayerSetting(key,0,uint32(revision.first));
+        bot->UpdatePlayerSetting(key,1,uint32(revision.first>>32));
+        bot->UpdatePlayerSetting(key,2,revision.second);
+    }
+    std::lock_guard<std::mutex> guard(StatesLock);
+    auto& state=States[bot->GetGUID().GetRawValue()];
+    state.appliedLevel=bot->GetLevel();state.usesFeaturedSlots=true;
+    for(size_t i=0;i<state.featuredSlots.size();++i)
+        state.featuredSlots[i]=i<slots->size()?(*slots)[i].value:0;
+    error.clear();
+    return true;
+#else
+    error="Free Pick unavailable";return false;
+#endif
+}
