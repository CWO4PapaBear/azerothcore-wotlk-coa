+std::string PinKey(unsigned archetype) { return "core.area52.bot.featured."+std::to_string(archetype); }
+
+CoaFeaturedRevision SavedRevision(Player const* bot,unsigned archetype)
+{
+    auto settings=bot->FindPlayerSettings(PinKey(archetype));
+    if (!settings || settings->size()<3) return {};
+    return {(uint64((*settings)[1].value)<<32) | (*settings)[0].value, (*settings)[2].value};
+}
+
+bool ReadPilotPlan(CoaFeaturedRevision revision, uint32 legendary, Area52Build::Entry& plan, std::string& error)
+{
+    if (!revision.first || !revision.second) { error="no linked Featured revision"; return false; }
+    auto row=CharacterDatabase.Query(
+        "SELECT JSON_UNQUOTE(JSON_EXTRACT(document,'$.wire')) FROM area52_build_revision "
+        "WHERE build_id={} AND revision={} AND category=8 LIMIT 1",revision.first,revision.second);
+    if (!row) { error="Featured revision unavailable"; return false; }
+    auto wire=row->Fetch()[0].Get<std::string>();
+    if (wire.empty() || wire.size()%2 || wire.size()>2*Area52Build::MaxPacketBytes)
+    { error="invalid Featured wire length";return false; }
+    std::vector<uint8> bytes(wire.size()/2);
+    for (size_t i=0;i<bytes.size();++i)
+    {
+        char const* first=wire.data()+2*i;
+        auto read=std::from_chars(first,first+2,bytes[i],16);
+        if(read.ec!=std::errc{} || read.ptr!=first+2) { error="invalid Featured wire encoding";return false; }
+    }
+    if (!Area52Build::Decode(bytes,plan) || plan.Id!=std::to_string(revision.first) ||
+        plan.Category!=8 || plan.Class!=CoaHeroClass || plan.Spells.empty())
+    { error="invalid Featured identity, class, category or selections";return false; }
+    unsigned copies=0;
+    for (auto const& enchant:plan.Enchants)
+        if(enchant.Id==legendary) copies+=enchant.Stacks;
+    if(copies!=1) { error="Featured revision must contain its registered Legendary exactly once";return false; }
+    return true;
+}
+
+bool ValidatePilotPlan(Player* bot, CoaLegendaryClass const& build, CoaFeaturedRevision revision,
+    Area52Build::Entry& plan, std::vector<AscensionFreePick::KnownEntry>& wanted,std::string& error)
+{
+    plan={};wanted.clear();
+    if (!ReadPilotPlan(revision,build.legendary,plan,error)) return false;
+    auto result=AscensionFreePick::PlanSelection(bot,plan,wanted);
+    if (!result) { error=std::string(result.Status)+" "+result.Learn;return false; }
+    if (!AscensionMysticEnchant::CanApplyDraftEnchants(bot,plan.Enchants))
+    { error="enchant loadout rejected by Area 52 slot, stack or connection rules"; return false; }
+    return true;
+}
