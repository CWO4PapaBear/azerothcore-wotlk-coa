+                    uint32 quoteKey = 0x80000000u | (cost << 24) | item;
+                    result << quoteKey << key << item << uint32(0) << offer.Currency;
+                    for (unsigned i = 0; i < 4; ++i) result << uint32(0);
+                    result << cost;
+                    for (unsigned i = 0; i < 6; ++i) result << uint32(0);
+                    ++count;
