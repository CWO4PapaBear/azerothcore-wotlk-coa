+void RestoreArea52HopliteForLogin(Player* player, PreparedQueryResult result)
+{
+    using namespace AscensionMysticEnchant;
+    if (!Applies(player) || !Connected.contains(978217))
+        return;
+    std::set<std::uint32_t> known;
+    if (result)
+        do
+        {
+            known.insert(result->Fetch()[0].Get<std::uint32_t>());
+        } while (result->NextRow());
+    auto const slots = ReadSlots(player);
+    if (std::find(slots.begin(), slots.end(), 978217) == slots.end() ||
+        !ValidateSlots(Data, slots, player->GetLevel(), known, Connected))
+        return;
+    auto const& entry = Data.BySpell.at(978217);
+    if (InvestmentMet(player, entry, false) && InvestmentMet(player, entry, true))
+        player->AddAura(978217, player);
+}
