+from pathlib import Path
+import json,sys,struct,re,hashlib
+root=Path(__file__).resolve().parents[3];p=root.parent/'Area52_Movement_Casting'
+if True:
+    sys.path.insert(0,str(root.parents[1]/'work/github-upload/tools'))
+    from lib.mpq import MPQArchive
+    client=Path('D:/DML WOTLK Client Side/Ascension A52 Free Pick/ascension-live/ascension-live/Data/area-52/patch-D.MPQ')
+    receipt=json.loads((p/'client-stage.json').read_text())
+    assert hashlib.sha256(client.read_bytes()).hexdigest()==receipt['before_sha256']
+    with MPQArchive(client) as before,MPQArchive(p/'patch-D.MPQ') as after:
+        names=before.read_file('(listfile)').decode().splitlines()
+        for name in names:
+            if name.lower() in ('(listfile)','(attributes)','(signature)') or not name:continue
+            old,new=before.read_file(name),after.read_file(name)
+            if name=='DBFilesClient\\Spell.dbc':
+                _,count,fields,size,_=struct.unpack_from('<4s4I',old)
+                old_pool,new_pool=old[20+count*size:],new[20+count*size:]
+                for i in range(count):
+                    a=list(struct.unpack_from('<'+'I'*fields,old,20+i*size));b=list(struct.unpack_from('<'+'I'*fields,new,20+i*size))
+                    x=old_pool[a[170]:old_pool.find(b'\0',a[170])];y=new_pool[b[170]:new_pool.find(b'\0',b[170])]
+                    pattern=rb'\|cff[0-9a-fA-F]{6}(?:NOT VERIFIED|VERIFIED)\|r'
+                    assert re.sub(pattern,b'',x)==re.sub(pattern,b'',y),a[0]
+                    if a[0] in receipt['repaired_spells']:
+                        assert a[31]==14 and b[31]==15
+                        a[31]=b[31]
+                    else:assert a[31]==b[31]
+                    if a[0]!=954611:assert x==y
+                    else:assert b'|cffff0000NOT VERIFIED|r' in y
+                    a[170]=b[170]=0;assert a==b
+            else:assert old==new,name
+    print('Client archive preserves all non-status tooltip text and fields; 106 movement flags are corrected; only unresolved Hand of Guldan status is downgraded.')
+
+
