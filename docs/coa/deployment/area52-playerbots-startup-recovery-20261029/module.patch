+        for (Bot const& bot : bots)
+            if (bot.available && bot.faction == request.faction && bot.role >= 1 && bot.role <= 3 &&
+                !reservations.contains(bot.id) && (*missing)[bot.role - 1])
+            {
+                --(*missing)[bot.role - 1];
+                selected.push_back(bot.id);
+            }
+        if ((*missing)[0] || (*missing)[1] || (*missing)[2] || reservations.size() + selected.size() > Capacity)
+            return false;
+        for (Id id : selected)
+            reservations.emplace(id, request);
+        return true;
+    }
+
+    bool CanMatch(std::set<Id> const& queues) const
+    {
+        for (Id id : queues)
+            if (auto found = reservations.find(id); found != reservations.end() &&
+                !queues.contains(found->second.queue))
+                return false;
+        return true;
+    }
+};
