+#ifndef PLAYERBOTS_AREA52_DUNGEON_POOL_H
+#define PLAYERBOTS_AREA52_DUNGEON_POOL_H
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <set>
+#include <vector>
+
+namespace Area52DungeonPool
+{
+using Id = std::uint64_t;
+constexpr std::size_t Capacity = 20;
+
+struct Request
+{
+    Id queue = 0;
+    Id leader = 0;
+    std::uint32_t level = 0;
+    std::uint32_t faction = 0;
+    std::set<std::uint32_t> dungeons;
+    std::map<Id, std::uint32_t> humans;
+    bool operator==(Request const&) const = default;
+};
+
+struct Bot
+{
+    Id id = 0;
+    std::uint32_t faction = 0;
+    std::uint32_t role = 0;
+    bool available = false;
+};
+
+inline std::optional<std::array<unsigned, 3>> MissingRoles(std::vector<std::uint32_t> const& roles,
+    std::size_t index = 0, std::array<unsigned, 3> remaining = { 1, 1, 3 })
+{
+    if (roles.size() > 5)
+        return std::nullopt;
+    if (index == roles.size())
+        return remaining;
+    for (unsigned slot = 0; slot < 3; ++slot)
+        if (remaining[slot] && (roles[index] & (2u << slot)))
+        {
+            auto next = remaining;
+            --next[slot];
+            if (auto result = MissingRoles(roles, index + 1, next))
+                return result;
+        }
+    return std::nullopt;
+}
+
+class Pool
+{
+public:
+    std::map<Id, Request> reservations;
+
+    std::vector<Id> Release(Id queue)
+    {
+        std::vector<Id> released;
+        for (auto it = reservations.begin(); it != reservations.end();)
+            if (it->second.queue == queue)
+            {
+                released.push_back(it->first);
+                it = reservations.erase(it);
+            }
+            else
+                ++it;
+        return released;
+    }
+
+    bool Reserve(Request const& request, std::vector<Bot> const& bots)
+    {
+        if (!request.queue || !request.leader || request.level < 15 || request.level > 80 ||
+            request.dungeons.empty() || request.humans.empty() || request.humans.size() >= 5 ||
+            !request.humans.contains(request.leader) || bots.size() > Capacity)
+            return false;
+        std::vector<std::uint32_t> roles;
+        for (auto const& [id, role] : request.humans)
+            roles.push_back(role);
+        auto missing = MissingRoles(roles);
+        if (!missing)
+            return false;
+        std::set<Id> ids;
