+#ifndef PLAYERBOTS_AREA52_FIXED_PILOT_H
+#define PLAYERBOTS_AREA52_FIXED_PILOT_H
+
+#include <cstdint>
+#include <array>
+#include <optional>
+#include <vector>
+
+namespace Area52FixedPilot
+{
+constexpr std::uint32_t Accounts = 2;
+constexpr std::uint32_t PerFaction = 10;
+constexpr char const* Setting = "core.area52.bot.pilot";
+
+constexpr std::uint32_t Role(std::uint32_t slot)
+{
+    return slot >= PerFaction ? 0 : slot < 2 ? 1 : slot < 4 ? 2 : 3;
+}
+
+constexpr char const* Spec(std::uint32_t role)
+{
+    return role == 1 ? "mknight" : role == 2 ? "naturalist" : role == 3 ? "hoplite" : "";
+}
+
+inline std::optional<std::vector<std::uint32_t>> MissingRoles(std::vector<std::uint32_t> const& saved)
+{
+    std::array<unsigned, 4> left = { 0, 2, 2, 6 };
+    for (auto role : saved)
+    {
+        if (role < 1 || role > 3 || !left[role])
+            return std::nullopt;
+        --left[role];
+    }
+    std::vector<std::uint32_t> missing;
+    for (unsigned role = 1; role <= 3; ++role)
+        for (unsigned count = 0; count < left[role]; ++count)
+            missing.push_back(role);
+    return missing;
+}
+}
+
+#endif
