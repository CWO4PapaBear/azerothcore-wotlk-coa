+inline Definition const* Find(std::uint32_t enchant)
+{
+    auto found = std::lower_bound(Catalog.begin(), Catalog.end(), enchant,
+        [](Definition const& entry, std::uint32_t value) { return entry.enchant < value; });
+    return found != Catalog.end() && found->enchant == enchant ? &*found : nullptr;
+}
+inline bool OwnsBuff(std::uint32_t source, std::uint32_t buff)
+{
+    auto entry = Find(source);
+    if (!entry)
+        return false;
+    switch (entry->family)
+    {
+        case Family::Fighter: return buff == 781000;
+        case Family::Wizard: return buff == 781300;
+        case Family::Primal: return buff == 781600;
+        case Family::Demonic: return buff == 781900;
+        case Family::Draconic: return buff == 782200 || buff == 782201;
+        case Family::Gigantic: return buff == 782500 || buff == 782501;
+        case Family::Necrotic: return buff == 782800;
+        case Family::ElementBound: return buff == 783100 || buff == 783101;
+    }
+    return false;
+}
+}
