-bool Handle(WorldSession* session, WorldPacket const& packet)
-{
-    if (!Enabled || !session)
-        return false;
-    std::lock_guard lock(InboxLock);
-    auto it = Inboxes.find(session);
-    if (it != Inboxes.end() && packet.size() <= 70 && it->second.size() < 2)
-        it->second.push_back(packet);
-    return true;
-}
