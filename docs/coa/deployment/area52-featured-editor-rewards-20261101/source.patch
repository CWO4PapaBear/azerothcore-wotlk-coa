-    auto const before = AscensionFreePick::KnownEntries(player);
-    if (!Learn(player, *state, maximumLevel))
-        return 0;
-    return AscensionFreePick::SameSelection(before, AscensionFreePick::KnownEntries(player)) ? 0 : 1;
