+bool Available(Player* bot)
+{
+    return bot && bot->IsInWorld() && bot->IsAlive() && !bot->IsInCombat() && !bot->GetGroup() &&
+        !bot->GetGroupInvite() && !bot->duel && !bot->IsInFlight() &&
+        !bot->IsBeingTeleported() && !bot->InBattleground() && !bot->InBattlegroundQueue() &&
+        bot->FindMap() && !bot->FindMap()->Instanceable() &&
+        sLFGMgr->GetState(bot->GetGUID()) == lfg::LFG_STATE_NONE;
+}
+
+std::optional<Area52DungeonPool::Request> RequestFor(Player* player)
+{
+    if (!player || !player->IsInWorld() || sRandomPlayerbotMgr.IsRandomBot(player))
+        return std::nullopt;
+    Group* group = player->GetGroup();
+    Player* leader = group ? ObjectAccessor::FindConnectedPlayer(group->GetLeaderGUID()) : player;
+    if (!leader || sRandomPlayerbotMgr.IsRandomBot(leader))
+        return std::nullopt;
+    ObjectGuid queue = group ? group->GetGUID() : leader->GetGUID();
+    auto state = sLFGMgr->GetState(queue);
+    if (state != lfg::LFG_STATE_QUEUED && state != lfg::LFG_STATE_PROPOSAL)
+        return std::nullopt;
+    Area52DungeonPool::Request result;
+    result.queue = queue.GetRawValue();
+    result.leader = leader->GetGUID().GetRawValue();
+    result.level = leader->GetLevel();
+    result.faction = leader->GetTeamId();
+    result.dungeons = sLFGMgr->GetSelectedDungeons(leader->GetGUID());
+    if (group)
+    {
+        if (group->isRaidGroup())
+            return std::nullopt;
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (!member || !member->IsInWorld() || sRandomPlayerbotMgr.IsRandomBot(member))
+                return std::nullopt;
+            result.humans.emplace(member->GetGUID().GetRawValue(), sLFGMgr->GetRoles(member->GetGUID()));
+        }
+    }
+    else
+        result.humans.emplace(result.leader, sLFGMgr->GetRoles(leader->GetGUID()));
+    return result;
+}
+
+bool Prepare(Player* bot, uint32 level)
+{
+    if (!Available(bot) || level < 15 || level > sWorld->getIntConfig(CONFIG_MAX_PLAYER_LEVEL))
+        return false;
+    auto const* build = FindCoaLegendaryClass(Area52FixedPilot::Spec(Role(bot)));
+    if (!build)
+        return false;
+    auto id = bot->GetGUID().GetRawValue();
+    if (PreparedLevels[id] != level || bot->GetLevel() != level)
+    {
+        if (bot->IsMounted())
+            bot->Dismount();
+        bot->GiveLevel(level);
+        bot->InitStatsForLevel(true);
+        std::string error;
+        if (!ApplyCoaLegendaryClass(bot, *build, error))
+            return false;
+        PlayerbotFactory factory(bot, level);
+        factory.InitSkills();
+        factory.InitAvailableSpells();
+        factory.SetDeterministic(true);
+        factory.InitEquipment(false, true);
+        factory.InitAmmo();
+        factory.InitPet();
+        bot->SaveToDB(false, false);
+        PreparedLevels[id] = level;
+        return false;
+    }
+    EnsureCoaLegendaryClass(bot);
+    if (!EnsureEquipment(bot))
+        return false;
+    if (!CoaLegendaryClassReady(bot))
+        return false;
+    for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+        if (Item* item = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot); item && bot->CanUseItem(item->GetTemplate()) != EQUIP_ERR_OK)
+            return false;
+    return bot->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND) != nullptr;
+}
+}
+
+bool IsPilot(Player* bot)
+{
+    return sPlayerbotAIConfig.enabled && sPlayerbotAIConfig.area52FixedPilot &&
+        sPlayerbotAIConfig.area52DungeonPool && bot && IsCoaHero(bot) &&
+        sRandomPlayerbotMgr.IsRandomBot(bot) && Role(bot) >= 1 && Role(bot) <= 3;
+}
+
+bool EnsureEquipment(Player* bot)
+{
+    if (!IsPilot(bot))
+        return false;
+    auto const& profile = Area52FixedEquipment::Profiles[Role(bot) - 1];
+    for (uint32 entry : profile)
+        if (entry && !sObjectMgr->GetItemTemplate(entry))
+            return false;
+    bool changed = false;
+    bool complete = true;
+    for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+    {
+        Item* current = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot);
+        uint32 const entry = profile[slot];
+        if ((!current && !entry) || (current && current->GetEntry() == entry))
+            continue;
+        Item* stored = nullptr;
+        if (entry)
+        {
+            for (uint8 position = INVENTORY_SLOT_ITEM_START; position < INVENTORY_SLOT_ITEM_END; ++position)
+                if (Item* item = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, position);
+                    item && item->GetEntry() == entry)
+                {
+                    stored = item;
+                    break;
+                }
+            for (uint8 bag = INVENTORY_SLOT_BAG_START; !stored && bag < INVENTORY_SLOT_BAG_END; ++bag)
+                if (Bag* container = bot->GetBagByPos(bag))
+                    for (uint32 position = 0; position < container->GetBagSize(); ++position)
+                        if (Item* item = container->GetItemByPos(position); item && item->GetEntry() == entry)
+                        {
+                            stored = item;
+                            break;
+                        }
+        }
+        uint16 destination = 0;
+        if (entry && (stored ? bot->CanEquipItem(slot, destination, stored, true) :
+            bot->CanEquipNewItem(slot, destination, entry, true)) != EQUIP_ERR_OK)
+        {
+            complete = false;
+            continue;
+        }
+        if (current)
+            bot->DestroyItem(INVENTORY_SLOT_BAG_0, slot, true);
+        if (stored)
+        {
+            bot->RemoveItem(stored->GetBagSlot(), stored->GetSlot(), true);
+            if (!bot->EquipItem(destination, stored, true))
+                complete = false;
+        }
+        else if (entry && !bot->EquipNewItem(destination, entry, true))
+            complete = false;
+        changed = true;
+    }
+    if (changed)
+        bot->SaveToDB(false, false);
+    return ApplyArea52PilotVanity(bot) && complete;
+}
+
+bool RecruiterAvailable(Player* master)
+{
+    if (!master || !master->IsInWorld() || GET_PLAYERBOT_AI(master) || !master->IsAlive() ||
+        master->IsInCombat() || master->duel || master->IsBeingTeleported() || master->IsInFlight() ||
+        master->InBattleground() || master->InBattlegroundQueue() || !master->FindMap() ||
+        master->FindMap()->Instanceable() || master->GetLevel() < 15 || master->GetLevel() > 80)
+        return false;
+    Group* group = master->GetGroup();
+    return (!group || (!group->isRaidGroup() && !group->IsFull() && group->GetLeaderGUID() == master->GetGUID())) &&
+        sLFGMgr->GetState(master->GetGUID()) == lfg::LFG_STATE_NONE &&
+        (!group || sLFGMgr->GetState(group->GetGUID()) == lfg::LFG_STATE_NONE);
+}
+
+bool RecruitAvailable(Player* bot, Player* master, unsigned role)
+{
+    PlayerbotAI* ai = bot ? GET_PLAYERBOT_AI(bot) : nullptr;
+    return IsPilot(bot) && Available(bot) && !Busy(bot->GetGUID()) && ai && !ai->GetMaster() &&
+        RecruiterAvailable(master) && bot->GetTeamId() == master->GetTeamId() && Role(bot) == role;
+}
+
+bool PrepareRecruit(Player* bot, Player* master)
+{
+    return bot && RecruitAvailable(bot, master, Role(bot)) && Prepare(bot, master->GetLevel());
+}
+
+bool Busy(ObjectGuid guid)
+{
+    return sPlayerbotAIConfig.area52DungeonPool && Pool.reservations.contains(guid.GetRawValue());
+}
+
+bool CanMatch(std::set<ObjectGuid> const& queues)
+{
+    if (!sPlayerbotAIConfig.area52DungeonPool)
+        return true;
+    std::set<Area52DungeonPool::Id> ids;
+    for (ObjectGuid guid : queues)
+        if (!guid.IsEmpty())
+            ids.insert(guid.GetRawValue());
+    if (!Pool.CanMatch(ids))
+        return false;
+    for (auto const& [id, request] : Pool.reservations)
+        if (ids.contains(id))
+        {
+            auto current = RequestFor(ObjectAccessor::FindConnectedPlayer(ObjectGuid(request.leader)));
+            Player* bot = ObjectAccessor::FindConnectedPlayer(ObjectGuid(id));
+            if (!current || *current != request || !bot || bot->GetLevel() != request.level)
+                return false;
+        }
+    return true;
+}
+
+void Update(uint32 diff)
+{
+    if (!sPlayerbotAIConfig.enabled || !sPlayerbotAIConfig.area52DungeonPool)
+        return;
+    Elapsed += diff;
+    if (Elapsed < 1000)
+        return;
+    Elapsed = 0;
+    std::map<Area52DungeonPool::Id, Area52DungeonPool::Request> requests;
+    for (Player* player : sRandomPlayerbotMgr.GetPlayers())
+        if (auto request = RequestFor(player))
+            requests.emplace(request->queue, *request);
+    std::set<Area52DungeonPool::Id> released;
+    for (auto const& [id, request] : Pool.reservations)
+    {
+        auto current = requests.find(request.queue);
+        Player* bot = ObjectAccessor::FindConnectedPlayer(ObjectGuid(id));
+        if (!bot || bot->GetGroup() || current == requests.end() || current->second != request)
+            released.insert(request.queue);
+    }
+    for (auto queue : released)
+        for (auto id : Pool.Release(queue))
+            if (Player* bot = ObjectAccessor::FindConnectedPlayer(ObjectGuid(id)); bot && !bot->GetGroup() &&
+                sLFGMgr->GetState(bot->GetGUID()) != lfg::LFG_STATE_NONE)
+                sLFGMgr->LeaveLfg(bot->GetGUID());
+    std::vector<Area52DungeonPool::Bot> bots;
+    for (auto it = sRandomPlayerbotMgr.GetPlayerBotsBegin(); it != sRandomPlayerbotMgr.GetPlayerBotsEnd(); ++it)
+        if (Player* bot = it->second; bot && sRandomPlayerbotMgr.IsRandomBot(bot))
+        {
+            if (IsPilot(bot) && Available(bot))
+                EnsureEquipment(bot);
+            bots.push_back({ bot->GetGUID().GetRawValue(), bot->GetTeamId(), Role(bot),
+                Available(bot) && !CoaLfgOfferedToOther(bot, nullptr) &&
+                GET_PLAYERBOT_AI(bot) && !GET_PLAYERBOT_AI(bot)->GetMaster() });
+        }
+    for (auto const& [queue, request] : requests)
+        if (sLFGMgr->GetState(ObjectGuid(queue)) == lfg::LFG_STATE_QUEUED)
+            Pool.Reserve(request, bots);
+    auto next = Pool.reservations.upper_bound(LastPrepared);
+    for (std::size_t checked = 0; checked < Pool.reservations.size(); ++checked)
+    {
+        if (next == Pool.reservations.end())
+            next = Pool.reservations.begin();
+        auto const& [id, request] = *next++;
+        Player* bot = ObjectAccessor::FindConnectedPlayer(ObjectGuid(id));
+        if (!Available(bot) || sLFGMgr->GetState(ObjectGuid(request.queue)) != lfg::LFG_STATE_QUEUED)
+            continue;
+        if (Prepare(bot, request.level))
+        {
+            auto dungeons = request.dungeons;
+            sLFGMgr->JoinLfg(bot, 1u << Role(bot), dungeons, "Area 52 dungeon companion");
+        }
+        LastPrepared = id;
+        break;
+    }
+}
+}
