+bool CreatePilotAccount(std::string username, std::string password, uint32 index)
+{
+    auto const* botConnection = PlayerbotsDatabase.GetConnectionInfo();
+    auto const* authConnection = LoginDatabase.GetConnectionInfo();
+    if (index >= Area52FixedPilot::Accounts || username.size() > MAX_ACCOUNT_STR || password.size() > MAX_PASS_STR ||
+        botConnection->host != authConnection->host || botConnection->port_or_socket != authConnection->port_or_socket)
+        return false;
+    auto const& schema = botConnection->database;
+    if (schema.empty() || !std::all_of(schema.begin(), schema.end(), [](unsigned char c)
+        { return std::isalnum(c) || c == '_'; }))
+        return false;
+    Utf8ToUpperOnlyLatin(username);
+    Utf8ToUpperOnlyLatin(password);
+    auto [salt, verifier] = Acore::Crypto::SRP6::MakeRegistrationData(username, password);
+    auto transaction = LoginDatabase.BeginTransaction();
+    auto* statement = LoginDatabase.GetPreparedStatement(LOGIN_INS_ACCOUNT);
+    statement->SetData(0, username);
+    statement->SetData(1, salt);
+    statement->SetData(2, verifier);
+    statement->SetData(3, uint8(sWorld->getIntConfig(CONFIG_EXPANSION)));
+    statement->SetData(4, std::string());
+    statement->SetData(5, std::string());
+    transaction->Append(statement);
+    LoginDatabase.EscapeString(username);
+    transaction->Append("INSERT INTO `{}`.playerbots_area52_pilot_owner (roster_index,account_id) "
+        "SELECT {},id FROM account WHERE username='{}'", schema, index, username);
+    transaction->Append("INSERT INTO realmcharacters (realmid,acctid,numchars) "
+        "SELECT r.id,a.id,0 FROM realmlist r JOIN account a ON a.username='{}'", username);
+    // LOGIN_INS_ACCOUNT is ASYNC-only; wait for its worker transaction, never a direct synchronous commit.
+    return LoginDatabase.AsyncCommitTransaction(transaction).m_future.get();
+}
