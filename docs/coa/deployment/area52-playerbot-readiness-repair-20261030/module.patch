-                    continue;
-                }
-                TalentTabEntry const* talentTabInfo = sTalentTabStore.LookupEntry(talentInfo->TalentTab);
-                if (!talentTabInfo)  // can be null, see InitPetTalents
-                    continue;
-                if (talentTabInfo->tabpage != tab)
