+bool PlayerbotFactory::IsSecondaryTradeSkill(uint16 skillId)
+{
+    switch (skillId)
+    {
+        case SKILL_COOKING:
+        case SKILL_FIRST_AID:
+        case SKILL_FISHING:
+            return true;
+        default:
+            return false;
+    }
