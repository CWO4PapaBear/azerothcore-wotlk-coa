-                        continue;
-                    }
-                    if (talentInfo->DependsOn)
-                    {
-                        bot->LearnPetTalent(pet->GetGUID(), talentInfo->DependsOn,
-                                            std::min(talentInfo->DependsOnRank, bot->GetFreeTalentPoints() - 1));
-                    }
