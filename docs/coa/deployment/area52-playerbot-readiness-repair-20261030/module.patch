+inline bool Allowed(std::uint32_t id)
+{
+    if (id >= 1339079 && id <= 1339133 && id != 1339091)
+        return true;
+    switch (id)
+    {
+        case 69:
+        case 42943: case 42944: case 42945: case 42946: case 42947: case 42948:
+        case 42949: case 42950: case 42951: case 42952: case 42984: case 42985:
+        case 42991: case 42992: case 44091: case 44092: case 44093: case 44094:
+        case 44095: case 44096: case 48677: case 48683: case 48685: case 48687:
+        case 48689: case 48691: case 48716: case 48718: case 50255: case 62035:
+        case 62036: case 62037: case 69891: case 1540350: case 1542943:
+        case 1542949: case 1548335: case 1548685:
+            return true;
+        default:
+            return false;
+    }
+}
+inline std::vector<std::uint32_t> const& Items()
+{
+    static std::vector<std::uint32_t> const items = []
+    {
+        std::vector<std::uint32_t> result;
+        for (std::uint32_t id : {69u, 1540350u, 1542943u, 1542949u, 1548335u, 1548685u})
+            result.push_back(id);
+        for (std::uint32_t id = 42943; id <= 69891; ++id)
+            if (Allowed(id))
+                result.push_back(id);
+        for (std::uint32_t id = 1339079; id <= 1339133; ++id)
+            if (Allowed(id))
+                result.push_back(id);
+        return result;
+    }();
+    return items;
+}
+}
