+-- Area 52 internal build imports and portable build codes.
+Area52BuildImport = {}
+local Import = Area52BuildImport
+local MAX_CODE = 100000
+
+local function integer(value, maximum)
+    assert(type(value) == "number" and value >= 0 and value <= maximum and value == math.floor(value), "Invalid number")
+    return value
+end
+
+local function text(value, maximum)
+    value = value or ""
+    assert(type(value) == "string" and #value <= maximum and not value:find("%z"), "Invalid text")
+    return value
+end
+
+local function array(value, maximum, convert)
+    assert(type(value) == "table" and #value <= maximum, "Invalid list")
+    local result, seen = {}, {}
+    for key in pairs(value) do assert(type(key) == "number" and key >= 1 and key <= #value and key == math.floor(key), "Invalid list index") end
+    for i, row in ipairs(value) do
+        result[i] = convert(row)
+        local id = result[i].Spell or result[i].Enchant or result[i].Type
+        assert(not seen[id], "Duplicate selection")
+        seen[id] = true
+    end
+    return result
+end
+
+function Import.Validate(build)
+    assert(type(build) == "table", "Invalid build")
+    local result = {}
+    for key, limit in pairs({Name=128, Icon=256, Description=8192}) do result[key] = text(build[key], limit) end
+    assert(#result.Name > 0, "Missing build name")
+    for _, key in ipairs({'Category','Roles','PrimaryStat','DifficultyRating'}) do result[key]=text(build[key],64) end
+    assert(Enum.BuildRoles[result.Roles] or result.Roles=='PLAYER_ROLE_NONE', 'Invalid role')
+    local stats={STAT_STRENGTH=true,STAT_AGILITY=true,STAT_INTELLECT=true,STAT_SPIRIT=true}
+    assert(stats[result.PrimaryStat], 'Invalid primary stat')
+    local validDifficulty=false
+    for _,value in pairs(Enum.BuildDifficulty) do if value==result.DifficultyRating then validDifficulty=true end end
+    assert(validDifficulty,'Invalid difficulty')
+    local validCategory = false
+    for _, key in ipairs({"Leveling", "Level60PvE", "Level60PvP", "Level70PvE", "Level70PvP", "BuildDraft", "BuildDraftEndGamePvE", "BuildDraftEndGamePvP"}) do
+        if Enum.BuildCategory[key] == result.Category then validCategory = true end
+    end
+    assert(validCategory, "Unsupported build category")
+    result.Spells = array(build.Spells, 512, function(row)
+        assert(type(row) == "table", "Invalid spell")
+        local r = {Spell=integer(row.Spell, 4294967295), Level=integer(row.Level or 1, 80), Comment=text(row.Comment,128), Flags=integer(row.Flags or 0,4294967295)}
+        assert(r.Spell > 0, "Invalid spell ID")
+        for _, key in ipairs({"IsCoreAbility", "IsOptimalAbility", "IsEmpoweringAbility", "IsSynergisticAbility"}) do
+            assert(row[key] == nil or type(row[key]) == "boolean", "Invalid spell role")
+            r[key] = row[key] or false
+        end
+        return r
+    end)
+    result.RandomEnchants = array(build.RandomEnchants, 64, function(row)
+        assert(type(row) == "table", "Invalid enchant")
+        local r = {Enchant=integer(row.Enchant,4294967295), Stacks=integer(row.Stacks,17), Level=integer(row.Level or 1,80), Comment=text(row.Comment,128), Flags=integer(row.Flags or 0,4294967295)}
+        assert(r.Enchant > 0 and r.Stacks > 0, "Invalid enchant selection")
+        return r
+    end)
+    for _, key in ipairs({"ArmorTypes", "WeaponTypes"}) do
+        result[key] = array(build[key],32,function(row)
+            assert(type(row) == "table", "Invalid equipment")
+            local kind=text(row.Type,64)
+            local allowed=key=='ArmorTypes' and Enum.ArmorSubClassSID or Enum.WeaponSubClassSID
+            assert(allowed[kind], 'Invalid equipment type')
+            return {Type=kind, Comment=text(row.Comment,128)}
+        end)
+    end
+    return result
+end
+
+local function pack(value)
+    if type(value) == "string" then return "s"..#value..":"..value end
+    if type(value) == "number" then return "n"..string.format("%.0f", value)..":" end
+    if type(value) == "boolean" then return value and "b1" or "b0" end
+    local keys = {}
+    for key in pairs(value) do keys[#keys+1] = key end
+    table.sort(keys, function(a,b) return tostring(a) < tostring(b) end)
+    local parts = {"t"..#keys..":"}
+    for _, key in ipairs(keys) do parts[#parts+1] = pack(key); parts[#parts+1] = pack(value[key]) end
+    return table.concat(parts)
+end
+
+function Import.Encode(build)
+    local raw = pack(Import.Validate(build))
+    local code = "A52B1:"..raw:gsub(".", function(c) return string.format("%02x",string.byte(c)) end)
+    assert(#code <= MAX_CODE, "Build is too large to share")
+    return code
+end
+
+function Import.Decode(code)
+    assert(type(code) == "string" and #code <= MAX_CODE, "Build code is too large")
+    code = code:match("^%s*(.-)%s*$")
+    assert(code:sub(1,6) == "A52B1:", "Expected an Area 52 build code (A52B1)")
+    local hex = code:sub(7)
+    assert(#hex % 2 == 0 and not hex:find("[^%x]"), "Invalid build code")
+    local raw = hex:gsub("..", function(pair) return string.char(tonumber(pair,16)) end)
+    local pos, nodes = 1, 0
+    local function read(depth)
+        nodes = nodes+1
+        assert(depth <= 5 and nodes <= 16000, "Build code exceeds limits")
+        local kind = raw:sub(pos,pos); pos=pos+1
+        if kind == "b" then
+            local b=raw:sub(pos,pos);pos=pos+1
+            assert(b=="0" or b=="1", "Invalid boolean")
+            return b=="1"
+        end
+        local stop=raw:find(":",pos,true)
+        assert(stop and stop-pos <= 10, "Invalid code length")
+        local digits=raw:sub(pos,stop-1)
+        assert(digits:match("^%d+$"), "Invalid code number")
+        local size=tonumber(digits);pos=stop+1
+        if kind=="n" then return integer(size,4294967295) end
+        if kind=="s" then
+            assert(size<=8192 and pos+size-1<=#raw,"Invalid text length")
+            local s=raw:sub(pos,pos+size-1);pos=pos+size;return s
+        end
+        assert(kind=="t" and size<=512,"Invalid code table")
+        local t={}
+        for i=1,size do
+            local key=read(depth+1)
+            assert((type(key)=="string" or type(key)=="number") and t[key]==nil,"Invalid or repeated key")
+            t[key]=read(depth+1)
+        end
+        return t
+    end
+    local build=read(0)
+    assert(pos==#raw+1,"Trailing build data")
+    return Import.Validate(build)
+end
+
+local function enabled()
+    return GetRealmName() == "Area 52 - Free-Pick"
+end
+
+local function showError(message)
+    UIErrorsFrame:AddMessage(tostring(message):gsub("^.-:%d+: ",""),1,0.2,0.2)
+end
+
+function Import.Apply(build)
+    local ok, copy=pcall(Import.Validate,build)
+    if not ok then showError(copy);return false end
+    if not C_Player:IsGM() and BuildCreatorUtil.IsCategoryBuildDraft(copy.Category) then
+        copy.Category=Enum.BuildCategory.Leveling
+    end
+    StaticPopup_Show("AREA52_CONFIRM_BUILD_COPY",copy.Name,nil,copy)
+    return true
+end
+
+function Import.Commit(copy)
+    copy=Import.Validate(copy)
+    if not C_Player:IsGM() and BuildCreatorUtil.IsCategoryBuildDraft(copy.Category) then copy.Category=Enum.BuildCategory.Leveling end
+    C_BuildEditor.DiscardPendingBuild()
+    for _, key in ipairs({"Name","Icon","Category","Description","Roles","PrimaryStat","DifficultyRating"}) do C_BuildEditor["Set"..key](copy[key]) end
+    for _, row in ipairs(copy.Spells) do C_BuildEditor.AddSpell(row) end
+    for _, row in ipairs(copy.RandomEnchants) do C_BuildEditor.AddRandomEnchant(row) end
+    for _, row in ipairs(copy.ArmorTypes) do C_BuildEditor.AddArmorType(row) end
+    for _, row in ipairs(copy.WeaponTypes) do C_BuildEditor.AddWeaponType(row) end
+    BuildCreatorFrame:CreateBuild(copy.Category,true)
+end
