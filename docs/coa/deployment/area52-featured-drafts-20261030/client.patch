+function Draft.Begin(playerName, buildID)
+    if GetRealmName() ~= "Area 52 - Free-Pick" then return false end
+    generation = generation + 1
+    local current = generation
+    request, attempts, awaiting = {name = playerName, id = buildID}, 0, false
+    local function attempt()
+        if generation ~= current or not request then return end
+        if UnitLevel("player") ~= 1 or UnitName("player") ~= request.name then
+            request, awaiting = nil, false
+            return
+        end
+        if attempts >= MAX_ATTEMPTS then
+            awaiting = false
