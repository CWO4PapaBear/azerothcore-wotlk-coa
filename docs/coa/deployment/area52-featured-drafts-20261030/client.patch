+        end
+        attempts = attempts + 1
+        awaiting = true
+        C_BuildCreator.ActivateBuild(request.id, true, true)
+        C_Timer.After(5, attempt)
+    end
+    C_Timer.After(2, attempt)
+    return true
+end
+
+function Draft.Result(result)
+    if not request or not awaiting then return end
+    awaiting = false
+    if result == "ACTIVATE_BUILD_OK" then
+        NewCharacterSetupUtil.SetCharacterData(request.name, "archetypeBuildID", nil)
+        request = nil
+        generation = generation + 1
+    elseif result ~= "ACTIVATE_BUILD_NOT_AVAILABLE" then
+        request = nil
+        generation = generation + 1
+        UIErrorsFrame:AddMessage("Your selected Draft is not available. The selection has been retained; ask a GM to register its Featured Draft.", 1, 0.3, 0.3)
+    end
+end
