+bool IsRemovalOnly(Slots const& before, Slots const& wanted)
+{
+    bool removed = false;
+    for (std::size_t i = 0; i < wanted.size(); ++i)
+    {
+        if (wanted[i] && wanted[i] != before[i])
+            return false;
+        removed |= before[i] && !wanted[i];
+    }
+    return removed;
+}
