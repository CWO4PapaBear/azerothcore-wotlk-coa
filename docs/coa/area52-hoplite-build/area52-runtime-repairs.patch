diff --git a/apps/coa-tests/area52_hoplite_client/run.py b/apps/coa-tests/area52_hoplite_client/run.py
new file mode 100644
--- /dev/null
+++ b/apps/coa-tests/area52_hoplite_client/run.py
@@ -0,0 +1,34 @@
+from pathlib import Path
+import json,struct,sys,hashlib
+root=Path(__file__).resolve().parents[3]
+p=root.parent/'Area52_Hoplite_Build_Audit'
+sys.path.insert(0,str(root.parents[1]/'work/github-upload/tools'))
+from lib.mpq import MPQArchive
+stage=json.loads((p/'client-stage.json').read_text())
+client=Path('D:/DML WOTLK Client Side/Ascension A52 Free Pick/ascension-live/ascension-live/Data/area-52/patch-D.MPQ')
+assert hashlib.sha256(client.read_bytes()).hexdigest()==stage['baseline_sha256']
+def files(path):
+    with MPQArchive(path) as archive:
+        return {n:archive.read_file(n) for n in archive.read_file('(listfile)').decode().splitlines() if n and n.lower() not in ('(listfile)','(attributes)','(signature)')}
+a,b=files(client),files(p/'patch-D.MPQ')
+assert a.keys()==b.keys()
+key='DBFilesClient\\Spell.dbc'
+for name in a:
+    if name!=key:assert a[name]==b[name],name
+old,new=a[key],b[key]
+_,count,fields,size,_=struct.unpack_from('<4s4I',old)
+assert old[:16]==new[:16]
+seen=[]
+def text(raw,row):
+    offset=struct.unpack_from('<I',row,680)[0]+20+count*size
+    return raw[offset:raw.find(b'\0',offset)]
+for i in range(count):
+    start=20+i*size;x=old[start:start+size];y=new[start:start+size]
+    assert x[:680]==y[:680] and x[684:]==y[684:]
+    before,after=text(old,x),text(new,y)
+    if before!=after:
+        sid=struct.unpack_from('<I',x)[0];seen.append(sid)
+        assert after==before.replace(b'|cffff0000NOT VERIFIED|r',b'|cffffff00VERIFIED|r'),sid
+assert sorted(seen)==sorted(stage['changed_tooltips'])
+assert seen
+print(f'{len(seen)} labels verified; original tooltip/SHIFT content and all other archive files unchanged.')
