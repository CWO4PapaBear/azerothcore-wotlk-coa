+from pathlib import Path
+import os,subprocess
+root=Path(__file__).resolve().parents[3]
+migration=(root/'data/sql/updates/pending_db_world/rev_20261010_00_area52_hoplite_support.sql').read_text()
+migration+='\n'+(root/'data/sql/updates/pending_db_world/rev_20261010_01_area52_hoplite_remaining.sql').read_text()
+prefix=[]
+for table in ('spell_proc','spell_script_names','spell_group'):
+    prefix.extend((f'CREATE TEMPORARY TABLE `{table}_copy` AS SELECT * FROM `{table}`;',
+                   f'CREATE TEMPORARY TABLE `{table}` LIKE `{table}_copy`;',
+                   f'INSERT INTO `{table}` SELECT * FROM `{table}_copy`;'))
+query='SELECT SpellId,ProcFlags,Chance,Cooldown FROM spell_proc WHERE SpellId IN (12834,12849,12867,51701,84445,912326,782246,979187,979188) ORDER BY SpellId;'
+sql='\n'.join(prefix)+'\n'+migration+'\n'+query+'\n'+migration+'\n'+query
+sql+='\nSELECT COUNT(*) FROM spell_group WHERE id=1059 AND spell_id=979189;'
+command=(['wsl','-d','dml-arch','-u','root','--'] if os.name=='nt' else [])+['docker','exec','-i','ascension-freepick-database','mysql','--defaults-extra-file=/run/secrets/mysql-root.cnf','-BN','acore_world']
+lines=subprocess.check_output(command,input=sql.encode()).decode().splitlines()
+assert len(lines)==19,lines
+assert lines[:9]==lines[9:18],lines
+assert lines[-1]=='1',lines
+assert '51701\t69904\t100\t3000' in lines,lines
+assert '84445\t69648\t100\t20000' in lines,lines
+print('Migration applied twice to connection-local temporary copies; no live table writes; proc values stable.')
