+    for spell in entry['movement']:
+        if spell['id']=='901200':
+            assert spell['channel']=='true'
+            assert any(e['aura']=='33' and int(e['base_points'])==-26 for e in spells[901200]['effects'])
+            continue
+        if spell['channel']=='true':
+            assert int(spell['channel_interrupt']) & 8,spell
+        elif int(spell['cast_ms'])>0:
+            assert int(spell['interrupt']) & 8,spell
+for sid in (12317,13045,13046,13047,13048,51701,84445,812297,912326):
+    assert 'spell_area52_hoplite_support_proc' in spells[sid]['scripts'],sid
+assert 'spell_area52_shattering_throw' in spells[64380]['scripts']
+assert 'spell_warr_shattering_throw' not in spells[64380]['scripts']
+assert 'aura_area52_sweeping_swings' in spells[12328]['scripts']
+assert 'spell_area52_sweeping_swings_damage' in spells[997604]['scripts']
+for sid,cooldown in ((12317,5000),(13048,5000),(51701,3000),(84445,20000),(912326,1000)):
+    assert int(spells[sid]['proc']['Cooldown'])==cooldown
+assert int(spells[51701]['proc']['HitMask'])==0
+for sid in (12834,12849,12867):
+    assert int(spells[sid]['proc']['ProcFlags'])==20
+    assert int(spells[sid]['proc']['HitMask'])==2
+sys.path.insert(0,str(root.parents[1]/'work/github-upload/tools'))
+from lib.mpq import MPQArchive
+client=Path('D:/DML WOTLK Client Side/Ascension A52 Free Pick/ascension-live/ascension-live/Data/area-52/patch-D.MPQ')
+with MPQArchive(client) as archive:raw=archive.read_file('DBFilesClient\\SpellRank.dbc')
+_,count,fields,size,_=struct.unpack_from('<4s4I',raw)
+groups={}
+for i in range(count):
+    row=struct.unpack_from('<4I',raw,20+i*size)
+    groups.setdefault(row[1],[]).append((row[3],row[2]))
+covered={sid for entry in decisions['entries'] for sid in entry['closure']}
+checked=[];mismatches=[];stacked=[]
+mystics={e["id"] for e in decisions["entries"] if e["kind"]=="mystic"}
+for group,values in groups.items():
+    chain=[sid for _,sid in sorted(values)]
+    if len(chain)<2 or not set(chain)&covered:continue
+    if chain[0] in mystics:
+        source=spells[chain[0]]
+        assert source["passive"]=="true" and int(source["stack_amount"])==3
+        stacked.append(group)
+        continue
+    actual=[];sid=chain[0];seen=set()
+    while sid and sid not in seen:
+        seen.add(sid);actual.append(sid)
+        sid=next((int(e['target']) for e in spells.get(sid,{}).get('edges',[]) or [] if e['kind']=='next_rank'),0)
+    if actual!=chain:mismatches.append({'group':group,'client':chain,'server':actual})
+    else:checked.append(group)
+(p/'rank-parity.json').write_text(json.dumps({'matched_groups':checked,'stackable_enchant_groups_not_book_ranks':stacked,'mismatches':mismatches},indent=2))
