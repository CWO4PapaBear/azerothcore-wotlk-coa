--- /dev/null
+++ b/apps/coa-tests/area52_batch10_client/run.py
@@ -0,0 +1,47 @@
+from pathlib import Path
+import hashlib
+import json
+import struct
+import sys
+
+root = Path(__file__).resolve().parents[3].parent.parent
+p = root / 'outputs/Area52_Legendary_Batch10'
+sys.path.insert(0, str(root / 'work/github-upload/tools'))
+from lib.mpq import MPQArchive
+
+manifest = json.loads((p / 'client-stage.json').read_text())
+source = Path('D:/DML WOTLK Client Side/Ascension A52 Free Pick/ascension-live/ascension-live/Data/area-52/patch-D.MPQ')
+assert hashlib.sha256(source.read_bytes()).hexdigest() == manifest['before_sha256']
+assert hashlib.sha256((p / 'patch-D.MPQ').read_bytes()).hexdigest() == manifest['after_sha256']
+with MPQArchive(source) as before, MPQArchive(p / 'patch-D.MPQ') as after:
+    names = {n for n in before.read_file('(listfile)').decode().splitlines()
+             if n and n.lower() not in ('(listfile)', '(signature)', '(attributes)')}
+    assert names == {n for n in after.read_file('(listfile)').decode().splitlines()
+                     if n and n.lower() not in ('(listfile)', '(signature)', '(attributes)')}
+    for name in names - {'DBFilesClient\\Spell.dbc'}:
+        assert before.read_file(name) == after.read_file(name), name
+    old = before.read_file('DBFilesClient\\Spell.dbc')
+    new = after.read_file('DBFilesClient\\Spell.dbc')
+_, count, fields, size, _ = struct.unpack_from('<4s4I', old)
+assert struct.unpack_from('<4s3I', old) == struct.unpack_from('<4s3I', new)
+changes = {(c['spell'], c['field']): c for c in manifest['changes']}
+for index in range(count):
+    offset = 20 + index * size
+    sid = struct.unpack_from('<I', old, offset)[0]
+    for field in range(fields):
+        left = struct.unpack_from('<I', old, offset + field * 4)[0]
+        right = struct.unpack_from('<I', new, offset + field * 4)[0]
+        if (sid, field) not in changes:
+            assert left == right, (sid, field)
+            continue
+        expected = changes[sid, field]
+        if field == 170:
+            pool_offset = 20 + count * size
+            left = old[pool_offset + left:old.find(b'\0', pool_offset + left)].decode()
+            right = new[pool_offset + right:new.find(b'\0', pool_offset + right)].decode()
+        assert left == expected['before'] and right == expected['after'], (sid, field)
+ids = set(json.loads((p / 'selected.json').read_text()))
+for sid in ids:
+    change = changes[sid, 170]
+    assert change['after'] == change['before'].replace('|cffff0000NOT VERIFIED|r', '|cffffff00VERIFIED|r')
+print('PASS: archive round-trip, only declared fields changed, all ten status labels and original SHIFT text preserved.')
