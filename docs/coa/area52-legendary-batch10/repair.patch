+from pathlib import Path
+import json
+import math
+
+p = Path(__file__).resolve().parents[3].parent / 'Area52_Legendary_Batch10'
+audit = json.loads((p / 'verification-ready-bindings/report.json').read_text())
+summary = audit['stages']['gameplay']['summary']
+assert summary['counts']['passed'] == 1 and summary['counts']['failed'] == 0
+assert not summary['failed_cases']
+effective = json.loads((p / 'full-catalog-activation/effective.json').read_text())
+spells = {int(s['id']): s for s in effective['spells']}
+ids = set(json.loads((p / 'selected.json').read_text()))
+assert {int(s['spell']) for s in effective['catalog']
+        if int(s['spell']) in ids and s['connected'] == 'true'} == ids
+for sid in ids - {81258, 99634}:
+    assert 'spell_area52_legendary_batch' in spells[sid]['scripts']
+for sid, cooldown in ((84510, 4000), (965503, 6000), (965504, 12000), (965505, 0)):
+    assert int(spells[sid]['proc']['Cooldown']) == cooldown
+for sid, charges in ((84748, 1), (983908, 2)):
+    assert int(spells[sid]['proc']['Charges']) == charges
+    assert 'spell_area52_slinger_consumption' in spells[sid]['scripts']
+for sid in (81123, 982220):
+    assert int(spells[sid]['stack_amount']) == 10
+assert int(spells[93582]['stack_amount']) == 5
+assert int(spells[983908]['effects'][0]['misc']) == 127
+assert int(spells[965509]['family_mask1']) & 32768
+assert spells[300600]['family'] == '5'
+assert spells[300600]['effects'][0]['aura'] == '275'
+assert spells[300600]['effects'][0]['class_mask0'] == '1'
+assert spells[954048]['effects'][0]['base_points'] == '-1'
+assert spells[954048]['effects'][0]['points_per_level'] == '3'
+for sid, direct, ap in ((84511, .25, .18), (965509, .7, .5), (965510, .3656, .2376),
+                       (954048, .0667, .0434), (954049, .11, .71)):
+    coeff = spells[sid]['coefficient_override']
+    assert math.isclose(float(coeff['direct']), direct, rel_tol=1e-6)
+    assert math.isclose(float(coeff['attack_power_direct']), ap, rel_tol=1e-6)
+for root, count in ((686, 13), (172, 10), (50796, 4), (944811, 4),
+                    (44425, 3), (2136, 11), (30455, 5)):
+    ranks = [s for s in spells.values() if int(s.get('rank_root', 0)) == root]
+    assert len(ranks) == count, (root, len(ranks))
+    assert {int(s['rank']) for s in ranks} == set(range(1, count + 1))
+    for spell in ranks:
+        assert spell['channel'] == 'false'
+        if int(spell['cast_ms']) > 0:
+            assert int(spell['interrupt']) & 8, spell['id']
+        if root == 944811:
+            assert 'spell_area52_pure_chaos_bolt' in spell['scripts']
+for sid, name in ((99634, 'spell_area52_corrupted_bear'),
+                  (5487, 'spell_area52_corrupted_bear_form'),
+                  (9634, 'spell_area52_corrupted_bear_form'),
+                  (17941, 'spell_area52_corrupted_bear_instant'),
+                  (34936, 'spell_area52_corrupted_bear_instant'),
+                  (965315, 'spell_area52_felfire_equipment'),
+                  (411119, 'spell_area52_felfire_emberstorm'),
+                  (954046, 'spell_area52_overloaded_mind'),
+                  (954048, 'spell_area52_froststorm_echo')):
+    assert name in spells[sid]['scripts'], (sid, name)
+print('PASS: ten native catalog connections, proc contracts, coefficients, helper bindings, 50 rank records and movement enforcement.')
diff --git a/apps/coa-tests/area52_batch10_client/run.py b/apps/coa-tests/area52_batch10_client/run.py
