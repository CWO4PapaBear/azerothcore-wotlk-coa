+from pathlib import Path
+import decimal,hashlib,json,re,sqlite3,subprocess
+root=Path(__file__).resolve().parents[3]
+p=root.parent/'Area52_Proc_Remaining31'
+receipt=json.loads((p/'activated.json').read_text())
+assert receipt['activated']
+stage=Path(receipt['stage'])
+migration='\n'.join((stage/'source/data/sql/updates/pending_db_world'/n).read_text() for n in receipt['migrations'])
+db=sqlite3.connect(':memory:')
+columns={}
+for table in ('spell_proc','spell_script_names'):
+    columns[table]=re.search(r'INSERT INTO `'+table+r'` \(([^)]+)\)',migration)[1]
+    db.execute('CREATE TABLE '+table+' ('+columns[table]+')')
+db.executescript(migration)
+def query(q):return subprocess.check_output(['docker','exec','ascension-freepick-database','mysql','--defaults-extra-file=/run/secrets/mysql-root.cnf','-BN','acore_world','-e',q],text=True).splitlines()
+counts={}
+for table in columns:
+    expected=db.execute('SELECT * FROM '+table+' ORDER BY 1,2').fetchall()
+    ids=','.join(str(row[0]) for row in expected)
+    key='SpellId' if table=='spell_proc' else 'spell_id'
+    condition=key+' IN ('+ids+')'
+    if table=='spell_script_names':condition+=" AND ScriptName IN ("+','.join("'"+row[1]+"'" for row in expected)+')'
+    actual=query('SELECT '+columns[table]+' FROM '+table+' WHERE '+condition+' ORDER BY 1,2;')
+    assert len(actual)==len(expected),(table,len(actual),len(expected))
+    for a,b in zip(actual,expected):
+        values=a.split('\t');assert len(values)==len(b)
+        for value,wanted in zip(values,b):
+            assert value==wanted if isinstance(wanted,str) else decimal.Decimal(value)==decimal.Decimal(str(wanted)),(table,b[0])
+    counts[table]=len(actual)
+binary=subprocess.check_output(['docker','exec','ascension-freepick-worldserver','sha256sum','/proc/1/exe'],text=True).split()[0]
+assert binary==receipt['binary_sha256']
+log=(stage/'startup.log').read_text()
+bad=[line for line in log.splitlines() if 'area52_' in line.lower() and any(s in line.lower() for s in ('did not pass','not found','failed','not exist'))]
+assert not bad,bad
+(p/'runtime-verification.json').write_text(json.dumps({'live_rows':counts,'binary_sha256':binary,'script_validation_errors':bad},indent=2))
+print('PASS: live proc rows and script bindings match migrations; running binary matches candidate; no Area 52 script validation failures.')
