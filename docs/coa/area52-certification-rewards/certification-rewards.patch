+from pathlib import Path
+import os
+from lupa.lua51 import LuaRuntime
+
+lua = LuaRuntime(unpack_returned_tuples=True)
+lua.execute('''
+StaticPopupDialogs = {}; SlashCmdList = {}; CANCEL = "Cancel"
+C_Player = {IsHero=function() return true end}
+C_CharacterAdvancement = {GetEntryBySpellID=function() return nil end}
+ModTooltipSetSpell = {}
+DEFAULT_CHAT_FRAME = {AddMessage=function() end}
+C_Timer = {After=function() end}
+function GetRealmName() return "Area 52 - Free-Pick" end
+function UnitName() return "Tester" end
+function GetTime() return 1 end
+function GetSpellInfo(id) return "Mystic "..id end
+function SendAddonMessage(prefix,message,channel,target) sent=message end
+function StaticPopup_Show(key,name,unused,data) popup={key=key,data=data} end
+function CreateFrame()
+  testFrame={RegisterEvent=function() end,SetScript=function(self,event,fn) self.event=fn end}
+  return testFrame
+end
+''')
+lua.execute(Path(os.environ['AREA52_CERTIFICATION_LUA']).read_text(encoding='utf-8-sig'))
+lua.execute('''
+local event=testFrame.event
+event(testFrame,"PLAYER_LOGIN")
+assert(sent=="SYNC")
+SlashCmdList.AREA52CERTIFYMYSTIC("81091")
+assert(popup==nil)
+event(testFrame,"CHAT_MSG_ADDON","A52CERT","BEGIN","WHISPER","Tester")
+event(testFrame,"CHAT_MSG_ADDON","A52CERT","V|2147564739","WHISPER","Tester")
+event(testFrame,"CHAT_MSG_ADDON","A52CERT","END","WHISPER","Tester")
+SlashCmdList.AREA52CERTIFYMYSTIC("81091")
+assert(popup.key=="AREA52_CERTIFY_MYSTIC" and popup.data.id==2147564739)
+assert(sent=="SYNC")
+StaticPopupDialogs[popup.key].OnAccept(nil,popup.data)
+assert(sent=="C|2147564739|7")
+event(testFrame,"CHAT_MSG_ADDON","A52CERT","OK|2147564739","WHISPER","Imposter")
+local left={text="|cffffff00VERIFIED|r",GetText=function(self) return self.text end,SetText=function(self,t) self.text=t end}
+ModTooltipSetSpell.Area52Certification(nil,left,nil,81091)
+assert(left.text=="|cffffff00VERIFIED|r")
+event(testFrame,"CHAT_MSG_ADDON","A52CERT","OK|2147564739","WHISPER","Tester")
+ModTooltipSetSpell.Area52Certification(nil,left,nil,81091)
+assert(left.text=="|cff00ff00CERTIFIED|r")
+popup=nil
+SlashCmdList.AREA52CERTIFYMYSTIC("81091")
+assert(popup==nil)
+SlashCmdList.AREA52CERTIFYMYSTIC("999999")
+assert(popup==nil)
+''')
+print('Lua 5.1 ME confirmation, submission, response attribution, tooltip and duplicate rejection passed.')
