@@ -0,0 +1,31 @@
+import os
+from pathlib import Path
+import runpy
+import shutil
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+method = runpy.run_path(str(HERE.parent / 'client_compat/run.py'))['method']
+
+
+def main():
+    source = (ROOT / 'src/server/game/Spells/SpellEffects.cpp').read_text(encoding='utf-8')
+    body = method(source, 'void Spell::EffectAscensionPctDamage(')
+    code = (HERE / 'harness.cpp').read_text(encoding='utf-8').replace('// ACTUAL_EFFECT', body)
+    compiler = shutil.which(os.environ.get('CXX', 'c++'))
+    assert compiler
+    with tempfile.TemporaryDirectory(prefix='area52-dungeon-percent-') as directory:
+        out = Path(directory)
+        cpp, exe = out / 'effect.cpp', out / 'effect'
+        cpp.write_text(code, encoding='utf-8')
+        subprocess.run([compiler, '-std=c++20', '-Wall', '-Wextra', '-Werror',
+                        '-I' + str(ROOT / 'src/server/game/Entities/Creature'), str(cpp), '-o', str(exe)],
+                       check=True, timeout=120)
+        subprocess.run([str(exe)], check=True, timeout=30)
+    print('PASS: dungeon percent damage math, effect phase, dead target, player, owned NPC and expansion exclusions')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/apps/coa-tests/area52_dungeon_percent_damage/harness.cpp b/apps/coa-tests/area52_dungeon_percent_damage/harness.cpp
new file mode 100644
--- /dev/null
+++ b/apps/coa-tests/area52_dungeon_percent_damage/harness.cpp
@@ -0,0 +1,91 @@
+#include "DungeonHealth.h"
+#include <cassert>
+#include <cstdint>
+
+using uint32 = std::uint32_t;
+using int32 = std::int32_t;
+using SpellEffIndex = int;
+constexpr int SPELL_EFFECT_HANDLE_LAUNCH_TARGET = 1;
+constexpr int BASE_ATTACK = 0;
+constexpr int SPELL_DIRECT_DAMAGE = 0;
+
+struct SpellInfo
+{
+    struct Effect { int MiscValue = 0; } Effects[3];
+};
+
+struct Creature;
+struct Unit
+{
+    Creature* creature = nullptr;
+    bool alive = true;
+    uint32 health = 10000;
+    float taken = 1.0f;
+    Creature* ToCreature() const { return creature; }
+    bool IsAlive() const { return alive; }
+    uint32 CalculateDamage(int, bool, bool) const { return 400; }
+    uint32 CountPctFromMaxHealth(int32 percent) const { return health * percent / 100; }
+    uint32 SpellDamageBonusTaken(Unit*, SpellInfo*, uint32 amount, int) const { return uint32(amount * taken); }
+};
+
+struct Creature : Unit
+{
+    bool owned = false;
+    uint32 map = 36;
+    bool IsCharmedOwnedByPlayerOrPlayer() const { return owned; }
+    uint32 GetMapId() const { return map; }
+};
+
+uint32 CalculatePct(uint32 value, int32 percent) { return value * percent / 100; }
+
+struct Spell
+{
+    Unit* m_caster;
+    Unit* unitTarget;
+    SpellInfo* m_spellInfo;
+    Unit* m_originalCaster;
+    int effectHandleMode = SPELL_EFFECT_HANDLE_LAUNCH_TARGET;
+    int32 damage = 25;
+    int32 m_damage = 0;
+    void EffectAscensionPctDamage(SpellEffIndex);
+};
+
+// ACTUAL_EFFECT
+
+int main()
+{
+    Creature npc;
+    npc.creature = &npc;
+    Unit player;
+    Unit target;
+    SpellInfo info;
+    Spell spell{&npc, &target, &info, &npc};
+    auto run = [&] { spell.m_damage = 0; spell.EffectAscensionPctDamage(0); return spell.m_damage; };
+    assert(run() == 2500);
+    target.taken = 0.5f;
+    assert(run() == 1250);
+    info.Effects[0].MiscValue = 1;
+    assert(run() == 50);
+    spell.m_originalCaster = nullptr;
+    assert(run() == 100);
+    spell.damage = 0;
+    assert(run() == 0);
+    spell.damage = 25;
+    spell.effectHandleMode = 0;
+    assert(run() == 0);
+    spell.effectHandleMode = SPELL_EFFECT_HANDLE_LAUNCH_TARGET;
+    target.alive = false;
+    assert(run() == 0);
+    target.alive = true;
+    npc.owned = true;
+    assert(run() == 0);
+    npc.owned = false;
+    for (uint32 map : {0, 1, 530, 571, 576, 533})
+    {
+        npc.map = map;
+        assert(run() == 0);
+    }
+    npc.map = 36;
+    spell.m_caster = &player;
+    assert(run() == 0);
+}
