+from pathlib import Path
+import json,subprocess,sys,struct,re,hashlib
+root=Path(__file__).resolve().parents[3];p=root.parent/'Area52_Rank_Batch22'
+changes=json.loads((p/'decisions.json').read_text());migration=(p/'rev_20261008_05_area52_advancement_rank_alignment.sql').read_text()
+review=json.loads((p/'client-review.json').read_text())
+definitions={int(spell):row for entry in review for chain in entry['chains'] for spell,row in chain['spells'].items()}
+sql='CREATE TEMPORARY TABLE spell_ranks_copy AS SELECT * FROM spell_ranks; CREATE TEMPORARY TABLE spell_ranks AS SELECT * FROM spell_ranks_copy;\n'+migration+migration+'\nSELECT first_spell_id,spell_id,`rank` FROM spell_ranks ORDER BY first_spell_id,`rank`;'
+data=subprocess.check_output(['docker','exec','-i','ascension-freepick-database','mysql','--defaults-extra-file=/run/secrets/mysql-root.cnf','-BN','acore_world'],input=sql.encode()).decode()
+chains={};spell_roots={}
+for line in data.splitlines():
+    first,spell,rank=map(int,line.split('\t'));chains.setdefault(first,[]).append((rank,spell));assert spell not in spell_roots;spell_roots[spell]=first
+for change in changes:
+    target=change['target'];actual=[s for _,s in chains.get(change['root'],[])] or [change['root']]
+    assert actual==target,(change['name'],actual,target)
+    if len(target)>1:
+        assert [r for r,_ in chains[change['root']]]==list(range(1,len(target)+1))
+        assert len(target)==len(set(target))
+        for rank in target:assert spell_roots[rank]==change['root']
+        levels=[max(definitions[spell]['level'],definitions[spell]['base_level']) for spell in target]
+        assert levels==sorted(levels),(change['name'],levels)
+print('All 25 chain decisions / 22 abilities pass against a temporary live-data copy; migration applied twice; no live writes.')
+if (p/'client-stage.json').exists():
+    sys.path.insert(0,str(root.parents[1]/'work/github-upload/tools'))
+    from lib.mpq import MPQArchive
+    client=Path('/mnt/d/DML WOTLK Client Side/Ascension A52 Free Pick/ascension-live/ascension-live/Data/area-52/patch-D.MPQ')
+    receipt=json.loads((p/'client-stage.json').read_text())
+    assert hashlib.sha256(client.read_bytes()).hexdigest()==receipt['before_sha256']
+    with MPQArchive(client) as before,MPQArchive(p/'patch-D.MPQ') as after:
+        names=before.read_file('(listfile)').decode().splitlines()
+        for name in names:
+            if name.lower() in ('(listfile)','(attributes)','(signature)') or not name:continue
+            old,new=before.read_file(name),after.read_file(name)
+            if name=='DBFilesClient\\Spell.dbc':
+                _,count,fields,size,_=struct.unpack_from('<4s4I',old)
+                old_pool,new_pool=old[20+count*size:],new[20+count*size:]
+                for i in range(count):
+                    a=list(struct.unpack_from('<'+'I'*fields,old,20+i*size));b=list(struct.unpack_from('<'+'I'*fields,new,20+i*size))
+                    x=old_pool[a[170]:old_pool.find(b'\0',a[170])];y=new_pool[b[170]:new_pool.find(b'\0',b[170])]
+                    pattern=rb'\|cff[0-9a-fA-F]{6}(?:NOT VERIFIED|VERIFIED)\|r'
+                    assert re.sub(pattern,b'',x)==re.sub(pattern,b'',y),a[0]
+                    a[170]=b[170]=0;assert a==b
+            elif name=='DBFilesClient\\SpellRank.dbc':
+                _,count,fields,size,_=struct.unpack_from('<4s4I',new)
+                for i in range(count):
+                    a=list(struct.unpack_from('<4I',old,20+i*size));b=list(struct.unpack_from('<4I',new,20+i*size))
+                    if a[1]==976 and a[2] in (48169,48170):a[3]=7 if a[2]==48169 else 8
+                    assert a==b
+            else:assert old==new,name
+    print('Client archive preserves all non-status tooltip text and fields; only two Shadow Protection rank indices change.')
