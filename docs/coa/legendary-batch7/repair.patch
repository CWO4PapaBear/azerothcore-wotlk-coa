+from pathlib import Path
+import subprocess, tempfile, sqlite3, re
+root = Path(__file__).resolve().parents[3]
+source = r'''#include "Area52LegendaryRules.h"
+#include <cassert>
+#include <initializer_list>
+using namespace Area52Legendary;
+int main() {
+for (auto id : {Purification,Curse,Stormbringer,Deathbringer,Zealot}) {
+assert(Accept(id,true,true,true,false,false));
+assert(!Accept(id,false,true,true,false,false));
+assert(!Accept(id,true,false,true,false,false));
+assert(!Accept(id,true,true,false,false,false));
+assert(!Accept(id,true,true,true,true,false));
+}
+assert(!Accept(Deathbringer,true,true,true,false,true));
+assert(Accept(Stormbringer,true,true,true,false,true));
+assert(!Accept(123,true,true,true,false,false));
+assert(ZealotAmount(1000,true)==200 && ZealotAmount(1000,false)==1000);
+assert(ZealotAmount(0,true)==0);
+}'''
+with tempfile.TemporaryDirectory() as temp:
+    path = Path(temp)
+    (path/'test.cpp').write_text(source)
+    subprocess.run(['c++','-std=c++20','-Wall','-Wextra','-Werror','-I',str(root/'src/server/coa'),str(path/'test.cpp'),'-o',str(path/'test')],check=True)
+    subprocess.run([str(path/'test')],check=True)
+sql = (root/'data/sql/updates/pending_db_world/rev_20261009_02_area52_legendary_procs.sql').read_text().replace("\\'", "''")
+db = sqlite3.connect(':memory:')
+for table in ('spell_proc','spell_script_names','spell_bonus_data'):
+    columns = re.search(r'INSERT INTO `'+table+r'` \(([^)]+)\)',sql)[1]
+    db.execute('CREATE TABLE '+table+' ('+columns+')')
+db.execute("INSERT INTO spell_script_names VALUES (84508,'unrelated')")
+db.execute("INSERT INTO spell_bonus_data VALUES (879,0.15,0,0.15,0,'source')")
+db.execute("INSERT INTO spell_bonus_data VALUES (26573,0,0.04,0,0.04,'source')")
+for _ in range(2):
+    db.executescript(sql)
+    assert db.execute('SELECT COUNT(*) FROM spell_proc').fetchone()[0]==5
+    assert db.execute('SELECT COUNT(*) FROM spell_script_names').fetchone()[0]==9
+    assert db.execute('SELECT Cooldown FROM spell_proc WHERE SpellId=965501').fetchone()[0]==3000
+    assert db.execute('SELECT Cooldown FROM spell_proc WHERE SpellId=965502').fetchone()[0]==3000
+    assert db.execute('SELECT direct_bonus,ap_bonus FROM spell_bonus_data WHERE entry=84760').fetchone()==(0.2,0.135)
+    assert db.execute('SELECT direct_bonus,ap_bonus FROM spell_bonus_data WHERE entry=84509').fetchone()==(0.15,0.15)
+    assert db.execute('SELECT dot_bonus,ap_dot_bonus FROM spell_bonus_data WHERE entry=84759').fetchone()==(0.04,0.04)
+print('PASS: Legendary proc gating, PvP reduction, SQL replay and unrelated binding preservation.')
