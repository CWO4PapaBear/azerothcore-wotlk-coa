+function GetRealmName() return "Area 52 - Free-Pick" end
+function UnitName() return "Tester" end
+function SendAddonMessage(prefix,message) sent=message end
+function CreateFrame(kind,name)
+    local f={scripts={}}
+    local methods={"RegisterEvent","SetSize","SetPoint","SetFrameStrata","SetBackdrop",
+        "EnableMouse","SetMovable","RegisterForDrag","StartMoving","StopMovingOrSizing",
+        "SetFrameLevel","SetWidth","SetHeight","SetJustifyH","SetTextColor","SetTexture",
+        "SetBackdropColor","SetBackdropBorderColor","SetNormalFontObject","SetHighlightFontObject",
+        "SetDisabledFontObject"}
+    for _,method in ipairs(methods) do f[method]=function() end end
+    function f:SetFrameStrata(strata) self.strata=strata end
+    function f:SetScript(event,fn) self.scripts[event]=fn end
+    function f:SetText(text) self.text=text end
+    function f:Show() self.visible=true end
+    function f:Enable() self.enabled=true end
+    function f:Disable() self.enabled=false end
+    function f:CreateFontString() return CreateFrame() end
+    function f:CreateTexture() return CreateFrame() end
+    frames[#frames+1]=f
+    if name then _G[name]=f end
