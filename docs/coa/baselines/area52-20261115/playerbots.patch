+void CoaFillMysticCollection(uint32 accountId)
+{
+#if COA_LEGENDARY_CLASSES
+    if (std::find(sPlayerbotAIConfig.randomBotAccounts.begin(), sPlayerbotAIConfig.randomBotAccounts.end(), accountId)
+        == sPlayerbotAIConfig.randomBotAccounts.end())
+        return;
+    static std::mutex lock;
+    if (!AscensionFreePick::Enabled())
+        return;
+    std::lock_guard<std::mutex> guard(lock);
+    AscensionMysticEnchant::Catalog catalog;
+    if (!AscensionMysticEnchant::LoadCatalog(catalog, GetClientDBCPath("MysticEnchant.dbc")) || catalog.BySpell.empty())
+        return;
+    std::set<uint32> missing;
+    for (auto const& [spell, entry] : catalog.BySpell)
+        missing.insert(spell);
+    if (QueryResult owned = CharacterDatabase.Query(
+            "SELECT `spell` FROM `account_freepick_mystic_collection` WHERE `account` = {}", accountId))
+    {
+        do
+            missing.erase(owned->Fetch()[0].Get<uint32>());
+        while (owned->NextRow());
+    }
+    if (missing.empty())
+        return;
+    std::ostringstream insert;
+    insert << "INSERT IGNORE INTO `account_freepick_mystic_collection` (`account`, `spell`) VALUES ";
+    bool first = true;
+    for (uint32 spell : missing)
+    {
+        insert << (first ? "" : ",") << '(' << accountId << ',' << spell << ')';
+        first = false;
+    }
+    CharacterDatabase.DirectExecute(insert.str());
+#else
+    (void)accountId;
+#endif
+}
