-
-    PerfMonitorOperation* pmo = sPerfMonitor.start(PERF_MON_RNDBOT, "IncreaseLevel");
-    uint32 lastLevel = GetValue(bot, "level");
-    uint8 level = bot->GetLevel() + 1;
-    if (level > maxLevel)
-    {
-        level = maxLevel;
-    }
-    if (lastLevel != level)
-    {
-        PlayerbotFactory factory(bot, level);
-        factory.Randomize(true);
-    }
-
-    if (pmo)
-        pmo->finish();
