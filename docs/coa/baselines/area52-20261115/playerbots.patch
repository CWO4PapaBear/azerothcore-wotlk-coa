-botPIDImpl::botPIDImpl(double dt, double max, double min, double Kp, double Ki, double Kd)
-    : _dt(dt), _max(max), _min(min), _Kp(Kp), _Ki(Ki), _Kd(Kd), _pre_error(0), _integral(0)
-{
