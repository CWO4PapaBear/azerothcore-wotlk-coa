+                        if (separator == std::string::npos) break;
+                        start = separator+1;
+                    }
+                }
+                checked.push_back(std::make_unique<TriggerNode>(condition,std::vector<NextAction>{{action,value}}));
+            }
+            for (auto& node : checked) triggers.push_back(node.release());
+            validatedPilotRules = true;
+            return;
+        }
+    }
