+class DestroyItemsVisitor : public IterateItemsVisitor
+{
+public:
+    DestroyItemsVisitor(Player* bot) : IterateItemsVisitor(), bot(bot) {}
+
+    bool Visit(Item* item) override
+    {
+        uint32 id = item->GetTemplate()->ItemId;
+        if (CoaDungeonPool::IsPilot(bot))
+        {
+            auto const* assigned = CoaDungeonPool::ProfileFor(bot);
+            if (!assigned) return true;
+            auto const& profile = assigned->equipment;
+            if (std::find(profile.begin(), profile.end(), id) != profile.end())
+                return true;
+        }
+        if (CanKeep(id))
+        {
+            keep.insert(id);
+            return true;
+        }
+
+        bot->DestroyItem(item->GetBagSlot(), item->GetSlot(), true);
+        return true;
+    }
+
+private:
+    bool CanKeep(uint32 id)
+    {
+        if (keep.find(id) != keep.end())
+            return false;
+
+        if (sPlayerbotAIConfig.IsInRandomQuestItemList(id))
+            return true;
+
+        return false;
+    }
+
+    Player* bot;
+    std::set<uint32> keep;
+};
