index 0000000..3297422
--- /dev/null
+++ b/src/Ai/Coa/CoaDungeonPool.cpp
@@ -0,0 +1,416 @@
+#include "CoaDungeonPool.h"
+#include "Area52DungeonPool.h"
+#include "Area52FixedPilot.h"
+#include "Area52PilotProfiles.h"
+#include "Area52BotFeaturedBuild.h"
+#include "ObjectMgr.h"
+#include "Bag.h"
+#include "CoaLegendaryClasses.h"
+#include "CoaSpecialization.h"
+#include "Playerbots.h"
+#include "Group.h"
+#include "Item.h"
+#include "LFGMgr.h"
+#include "Map.h"
+#include "ObjectAccessor.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "PlayerbotAIConfig.h"
+#include "PlayerbotFactory.h"
+#include "RandomPlayerbotMgr.h"
+#include "World.h"
+#include "Chat.h"
+#include "CustomStrategy.h"
+#include <ctime>
+
+bool ApplyArea52PilotVanity(Player* player);
+
+namespace CoaDungeonPool
+{
+namespace
+{
+Area52DungeonPool::Pool Pool;
+uint32 Elapsed = 0;
+Area52DungeonPool::Id LastPrepared = 0;
+std::map<Area52DungeonPool::Id, std::tuple<uint32,uint32,CoaFeaturedRevision>> PreparedLevels;
+std::map<Area52DungeonPool::Id, std::time_t> PreparingSince;
+std::map<Area52DungeonPool::Id, Area52DungeonPool::Request> FailedRequests;
+
+uint32 HomeRole(Player const* bot)
+{
+    auto const* settings = bot->FindPlayerSettings(Area52FixedPilot::Setting);
+    return settings && !settings->empty() ? settings->front().value : 0;
+}
+
+bool Available(Player* bot)
+{
+    return bot && bot->IsInWorld() && bot->IsAlive() && !bot->IsInCombat() && !bot->GetGroup() &&
+        !bot->GetGroupInvite() && !bot->duel && !bot->IsInFlight() &&
+        !bot->IsBeingTeleported() && !bot->InBattleground() && !bot->InBattlegroundQueue() &&
+        bot->FindMap() && !bot->FindMap()->Instanceable() &&
+        sLFGMgr->GetState(bot->GetGUID()) == lfg::LFG_STATE_NONE;
+}
+
+std::optional<Area52DungeonPool::Request> RequestFor(Player* player)
+{
+    if (!player || !player->IsInWorld() || sRandomPlayerbotMgr.IsRandomBot(player))
+        return std::nullopt;
+    Group* group = player->GetGroup();
+    Player* leader = group ? ObjectAccessor::FindConnectedPlayer(group->GetLeaderGUID()) : player;
+    if (!leader || sRandomPlayerbotMgr.IsRandomBot(leader))
+        return std::nullopt;
+    ObjectGuid queue = group ? group->GetGUID() : leader->GetGUID();
+    auto state = sLFGMgr->GetState(queue);
+    if (state != lfg::LFG_STATE_QUEUED && state != lfg::LFG_STATE_PROPOSAL)
+        return std::nullopt;
+    Area52DungeonPool::Request result;
+    result.queue = queue.GetRawValue();
+    result.leader = leader->GetGUID().GetRawValue();
+    result.level = leader->GetLevel();
+    result.faction = leader->GetTeamId();
+    result.dungeons = sLFGMgr->GetSelectedDungeons(leader->GetGUID());
+    if (group)
+    {
+        if (group->isRaidGroup())
+            return std::nullopt;
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (!member || !member->IsInWorld() || sRandomPlayerbotMgr.IsRandomBot(member))
+                return std::nullopt;
+            result.humans.emplace(member->GetGUID().GetRawValue(), sLFGMgr->GetRoles(member->GetGUID()));
+        }
+    }
+    else
+        result.humans.emplace(result.leader, sLFGMgr->GetRoles(leader->GetGUID()));
+    return result;
+}
+
+bool Prepare(Player* bot, uint32 level, unsigned role)
+{
+    if (!Available(bot) || level < 15 || level > sWorld->getIntConfig(CONFIG_MAX_PLAYER_LEVEL))
+        return false;
+    auto const* current = ProfileFor(bot);
+    auto profile = Area52PilotProfiles::Select(role, current ? current->legendary : 0, bot->GetGUID().GetCounter());
+    auto const* build = profile ? FindCoaLegendaryClass(std::string(profile->spec)) : nullptr;
+    if (!build)
+        return false;
+    auto id = bot->GetGUID().GetRawValue();
+    auto revision = CurrentCoaFeaturedRevision(profile->archetype);
+    auto key = std::make_tuple(level, build->legendary, revision);
+    if (PreparedLevels[id] != key || bot->GetLevel() != level || current != profile)
+    {
+        if (bot->IsMounted())
+            bot->Dismount();
+        bot->GiveLevel(level);
+        bot->InitStatsForLevel(true);
+        std::string error;
+        bot->UpdatePlayerSetting("core.area52.bot.assignment", 0, profile->legendary);
+        if (!ApplyCoaFeaturedRevision(bot, *build, revision, error))
+        {
+            bot->UpdatePlayerSetting("core.area52.bot.assignment", 0, current ? current->legendary : 0);
+            PreparedLevels.erase(id);
+            return false;
+        }
+        bot->UpdatePlayerSetting("core.area52.bot.assignment", 1, profile->vanity);
+        PlayerbotFactory factory(bot, level);
+        factory.InitSkills();
+        factory.InitAvailableSpells();
+        factory.SetDeterministic(true);
+        factory.InitEquipment(false, true);
+        factory.InitAmmo();
+        factory.InitPet();
+        bot->SaveToDB(false, false);
+        PreparedLevels[id] = key;
+        return false;
+    }
+    EnsureCoaLegendaryClass(bot);
+    if (!EnsureEquipment(bot))
+        return false;
+    if (GetCoaLegendaryClass(bot) != build || !CoaLegendaryClassReady(bot))
+        return false;
+    for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+        if (Item* item = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot); item && bot->CanUseItem(item->GetTemplate()) != EQUIP_ERR_OK)
+            return false;
+    if (!bot->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND))
+        return false;
+    if (PlayerbotAI* ai = GET_PLAYERBOT_AI(bot))
+        ai->ResetStrategies();
+    return ReadyForRole(bot, role);
+}
+}
+
+Area52PilotProfiles::Profile const* ProfileFor(Player const* bot)
+{
+    if (!bot || HomeRole(bot) < 1 || HomeRole(bot) > 3)
+        return nullptr;
+    auto const* saved = bot->FindPlayerSettings("core.area52.bot.assignment");
+    if (saved && !saved->empty() && saved->front().value)
+        return Area52PilotProfiles::Find(saved->front().value);
+    return Area52PilotProfiles::Select(HomeRole(bot), 0, bot->GetGUID().GetCounter());
+}
+
+bool IsPilot(Player* bot)
+{
+    return sPlayerbotAIConfig.enabled && sPlayerbotAIConfig.area52FixedPilot &&
+        sPlayerbotAIConfig.area52DungeonPool && bot && IsCoaHero(bot) &&
+        sRandomPlayerbotMgr.IsRandomBot(bot) && HomeRole(bot) >= 1 && HomeRole(bot) <= 3;
+}
+
+bool ReadyForRole(Player* bot, unsigned role)
+{
+    auto profile = ProfileFor(bot);
+    auto build = bot ? GetCoaLegendaryClass(bot) : nullptr;
+    auto ai = bot ? GET_PLAYERBOT_AI(bot) : nullptr;
+    if (!ai || !profile || profile->role != role || !build || build->legendary != profile->legendary ||
+        !CoaLegendaryClassReady(bot)) return false;
+    auto loaded = [&](std::string const& name, BotState state)
+    {
+        if (!ai->HasStrategy(name,state)) return false;
+        auto strategy = dynamic_cast<CustomStrategy*>(ai->GetAiObjectContext()->GetStrategy(name));
+        return strategy && strategy->HasValidatedPilotRules();
+    };
+    return loaded(build->combat,BOT_STATE_COMBAT) && loaded(build->nonCombat,BOT_STATE_NON_COMBAT);
+}
+
+bool EnsureEquipment(Player* bot)
+{
+    if (!IsPilot(bot))
+        return false;
+    auto assigned = ProfileFor(bot);
+    if (!assigned) return false;
+    auto const& profile = assigned->equipment;
+    for (uint32 entry : profile)
+        if (entry && !sObjectMgr->GetItemTemplate(entry))
+            return false;
+    bool changed = false;
+    bool complete = true;
+    for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+    {
+        Item* current = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot);
+        uint32 const entry = profile[slot];
+        if ((!current && !entry) || (current && current->GetEntry() == entry))
+            continue;
+        Item* stored = nullptr;
+        if (entry)
+        {
+            for (uint8 position = INVENTORY_SLOT_ITEM_START; position < INVENTORY_SLOT_ITEM_END; ++position)
+                if (Item* item = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, position);
+                    item && item->GetEntry() == entry)
+                {
+                    stored = item;
+                    break;
+                }
+            for (uint8 bag = INVENTORY_SLOT_BAG_START; !stored && bag < INVENTORY_SLOT_BAG_END; ++bag)
+                if (Bag* container = bot->GetBagByPos(bag))
+                    for (uint32 position = 0; position < container->GetBagSize(); ++position)
+                        if (Item* item = container->GetItemByPos(position); item && item->GetEntry() == entry)
+                        {
+                            stored = item;
+                            break;
+                        }
+        }
+        uint16 destination = 0;
+        if (entry && (stored ? bot->CanEquipItem(slot, destination, stored, true) :
+            bot->CanEquipNewItem(slot, destination, entry, true)) != EQUIP_ERR_OK)
+        {
+            complete = false;
+            continue;
+        }
+        if (current)
+            bot->DestroyItem(INVENTORY_SLOT_BAG_0, slot, true);
+        if (stored)
+        {
+            bot->RemoveItem(stored->GetBagSlot(), stored->GetSlot(), true);
+            if (!bot->EquipItem(destination, stored, true))
+                complete = false;
+        }
+        else if (entry && !bot->EquipNewItem(destination, entry, true))
+            complete = false;
+        changed = true;
+    }
+    if (changed)
+        bot->SaveToDB(false, false);
+    return ApplyArea52PilotVanity(bot) && complete;
+}
+
+bool RecruiterAvailable(Player* master)
+{
+    if (!master || !master->IsInWorld() || GET_PLAYERBOT_AI(master) || !master->IsAlive() ||
+        master->IsInCombat() || master->duel || master->IsBeingTeleported() || master->IsInFlight() ||
+        master->InBattleground() || master->InBattlegroundQueue() || !master->FindMap() ||
+        master->FindMap()->Instanceable() || master->GetLevel() < 15 || master->GetLevel() > 80)
+        return false;
+    Group* group = master->GetGroup();
+    return (!group || (!group->isRaidGroup() && !group->IsFull() && group->GetLeaderGUID() == master->GetGUID())) &&
+        sLFGMgr->GetState(master->GetGUID()) == lfg::LFG_STATE_NONE &&
+        (!group || sLFGMgr->GetState(group->GetGUID()) == lfg::LFG_STATE_NONE);
+}
+
+bool RecruitAvailable(Player* bot, Player* master, unsigned role)
+{
+    PlayerbotAI* ai = bot ? GET_PLAYERBOT_AI(bot) : nullptr;
+    return IsPilot(bot) && Available(bot) && !Busy(bot->GetGUID()) && ai && !ai->GetMaster() &&
+        RecruiterAvailable(master) && bot->GetTeamId() == master->GetTeamId() && Area52PilotProfiles::Select(role, 0, bot->GetGUID().GetCounter());
+}
+
+bool PrepareRecruit(Player* bot, Player* master, unsigned role)
+{
+    return bot && RecruitAvailable(bot, master, role) && Prepare(bot, master->GetLevel(), role);
+}
+
+bool Busy(ObjectGuid guid)
+{
+    std::lock_guard lock(ClaimsLock());
+    return sPlayerbotAIConfig.area52DungeonPool && Pool.reservations.contains(guid.GetRawValue());
+}
+
+std::recursive_mutex& ClaimsLock()
+{
+    static std::recursive_mutex mutex;
+    return mutex;
+}
+
+bool CanMatch(std::set<ObjectGuid> const& queues)
+{
+    if (!sPlayerbotAIConfig.area52DungeonPool)
+        return true;
+    std::set<Area52DungeonPool::Id> ids;
+    for (ObjectGuid guid : queues)
+        if (!guid.IsEmpty())
+            ids.insert(guid.GetRawValue());
+    Area52DungeonPool::Pool snapshot;
+    {
+        std::lock_guard lock(ClaimsLock());
+        snapshot = Pool;
+    }
+    if (!snapshot.CanMatch(ids))
+        return false;
+    for (auto const& [id, request] : snapshot.reservations)
+        if (ids.contains(id))
+        {
+            auto current = RequestFor(ObjectAccessor::FindConnectedPlayer(ObjectGuid(request.leader)));
+            Player* bot = ObjectAccessor::FindConnectedPlayer(ObjectGuid(id));
+            if (!current || *current != request || !bot || bot->GetLevel() != request.level ||
+                !ReadyForRole(bot, request.assignedRole))
+                return false;
+        }
+    return true;
+}
+
+static void MatchPartyLeader(Player* leader)
+{
+    if (!leader || !leader->IsInWorld() || !leader->IsAlive() || leader->IsInCombat() ||
+        leader->duel || leader->IsInFlight() || leader->IsBeingTeleported() ||
+        leader->InBattleground() || leader->InBattlegroundQueue() || sRandomPlayerbotMgr.IsRandomBot(leader))
+        return;
+    Group* group=leader->GetGroup();
+    if (!group || group->isRaidGroup() || group->GetLeaderGUID()!=leader->GetGUID()) return;
+    for (GroupReference* ref=group->GetFirstMember();ref;ref=ref->next())
+    {
+        Player* bot=ref->GetSource();
+        if (!bot || bot==leader || !IsPilot(bot) || !PartyBotNeedsProgress(bot,leader->GetLevel()) ||
+            !bot->IsInWorld() || !bot->IsAlive() || bot->GetMap()!=leader->GetMap() ||
+            bot->IsInCombat() || bot->duel || bot->IsInFlight() || bot->IsBeingTeleported() ||
+            bot->InBattleground() || bot->InBattlegroundQueue() || bot->IsNonMeleeSpellCast(false)) continue;
+        std::string error;
+        if (!AdvanceCoaPartyBot(bot,leader->GetLevel(),error) && !error.empty())
+            LOG_DEBUG("playerbots","Party level sync for {} at {}: {}",bot->GetName(),leader->GetLevel(),error);
+    }
+}
+void Update(uint32 diff)
+{
+    if (!sPlayerbotAIConfig.enabled || !sPlayerbotAIConfig.area52DungeonPool)
+        return;
+    Elapsed += diff;
+    if (Elapsed < 1000)
+        return;
+    Elapsed = 0;
+    static uint32 nextPartySync=0;
+    uint32 nowMs=getMSTime();
+    if (!nextPartySync || int32(nowMs-nextPartySync)>=0)
+    {
+        nextPartySync=nowMs+10000;
+        for (Player* player : sRandomPlayerbotMgr.GetPlayers()) MatchPartyLeader(player);
+    }
+    std::map<Area52DungeonPool::Id, Area52DungeonPool::Request> requests;
+    for (Player* player : sRandomPlayerbotMgr.GetPlayers())
+        if (auto request = RequestFor(player))
+            requests.emplace(request->queue, *request);
+    std::set<Area52DungeonPool::Id> released;
+    auto now = std::time(nullptr);
+    for (auto it = FailedRequests.begin(); it != FailedRequests.end();)
+        if (auto current = requests.find(it->first); current == requests.end() || current->second != it->second)
+            it = FailedRequests.erase(it);
+        else ++it;
+    for (auto const& [id, request] : Pool.reservations)
+    {
+        auto current = requests.find(request.queue);
+        Player* bot = ObjectAccessor::FindConnectedPlayer(ObjectGuid(id));
+        if (!bot || bot->GetGroup() || current == requests.end() || current->second != request)
+            released.insert(request.queue);
+        else if (sLFGMgr->GetState(bot->GetGUID()) == lfg::LFG_STATE_NONE &&
+            now - PreparingSince.try_emplace(id,now).first->second >= 120)
+        {
+            released.insert(request.queue);
+            if (FailedRequests.emplace(request.queue,request).second)
+                if (Player* leader = ObjectAccessor::FindConnectedPlayer(ObjectGuid(request.leader)))
+                    ChatHandler(leader->GetSession()).SendSysMessage("A dungeon bot could not prepare its assigned role. Its reservation was released. Requeue to try again.");
+        }
+    }
+    for (auto queue : released)
+    {
+        std::vector<Area52DungeonPool::Id> ids;
+        {
+            std::lock_guard lock(ClaimsLock());
+            ids = Pool.Release(queue);
+        }
+        for (auto id : ids)
+        {
+            PreparingSince.erase(id);
+            if (Player* bot = ObjectAccessor::FindConnectedPlayer(ObjectGuid(id)); bot && !bot->GetGroup() &&
+                sLFGMgr->GetState(bot->GetGUID()) != lfg::LFG_STATE_NONE)
+                sLFGMgr->LeaveLfg(bot->GetGUID());
+        }
+    }
+    std::vector<Area52DungeonPool::Bot> bots;
+    for (auto it = sRandomPlayerbotMgr.GetPlayerBotsBegin(); it != sRandomPlayerbotMgr.GetPlayerBotsEnd(); ++it)
+        if (Player* bot = it->second; bot && sRandomPlayerbotMgr.IsRandomBot(bot))
+        {
+            if (IsPilot(bot) && Available(bot))
+                EnsureEquipment(bot);
+            bots.push_back({ bot->GetGUID().GetRawValue(), bot->GetTeamId(), ProfileFor(bot) ? ProfileFor(bot)->role : 0,
+                Available(bot) && !CoaLfgOfferedToOther(bot, nullptr) &&
+                GET_PLAYERBOT_AI(bot) && !GET_PLAYERBOT_AI(bot)->GetMaster() });
+        }
+    for (auto const& [queue, request] : requests)
+        if (!FailedRequests.contains(queue) && sLFGMgr->GetState(ObjectGuid(queue)) == lfg::LFG_STATE_QUEUED)
+        {
+            std::lock_guard lock(ClaimsLock());
+            for (auto& candidate : bots)
+                if (candidate.available)
+                {
+                    auto bot = ObjectAccessor::FindConnectedPlayer(ObjectGuid(candidate.id));
+                    candidate.available = bot && !CoaLfgOfferedToOther(bot,nullptr);
+                }
+            Pool.Reserve(request, bots);
+        }
+    auto next = Pool.reservations.upper_bound(LastPrepared);
+    for (std::size_t checked = 0; checked < Pool.reservations.size(); ++checked)
+    {
+        if (next == Pool.reservations.end())
+            next = Pool.reservations.begin();
+        auto const& [id, request] = *next++;
+        Player* bot = ObjectAccessor::FindConnectedPlayer(ObjectGuid(id));
+        if (!Available(bot) || sLFGMgr->GetState(ObjectGuid(request.queue)) != lfg::LFG_STATE_QUEUED)
+            continue;
+        if (Prepare(bot, request.level, request.assignedRole))
+        {
+            auto dungeons = request.dungeons;
+            sLFGMgr->JoinLfg(bot, 1u << request.assignedRole, dungeons, "Area 52 dungeon companion");
+        }
+        LastPrepared = id;
+        break;
+    }
+}
+}
