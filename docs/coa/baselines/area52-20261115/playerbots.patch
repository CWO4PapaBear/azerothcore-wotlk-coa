-std::vector<uint32> parseBrackets(std::string const& str)
-{
-    std::vector<uint32> brackets;
-    std::stringstream ss(str);
-    std::string item;
-
-    while (std::getline(ss, item, ','))
-    {
-        brackets.push_back(static_cast<uint32>(std::stoi(item)));
-    }
-
-    return brackets;
-}
