-                    loginBots--;
-                }
-
-                if (!loginBots)
-                    break;
-            }
-
-            DelayLoginBotsTimer = 0;
-        }
-    }
-
-    if (pmo)
-        pmo->finish();
-
-    if (sPlayerbotAIConfig.hasLog("player_location.csv"))
-    {
-        LogPlayerLocation();
-    }
