+    InitAmmo();
+    InitFood();
+    InitReagents();
+    InitConsumables();
+    InitPotions();
+    InitPet();
+    InitPetTalents();
+    InitSkills();
+    InitClassSpells();
+    InitAvailableSpells();
+    InitReputation();
+    InitSpecialSpells();
+    InitMounts();
