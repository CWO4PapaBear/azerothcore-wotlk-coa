+void PlayerbotFactory::Refresh()
+{
+    // Prepare();
+    // if (!sPlayerbotAIConfig.equipAndSpecPersistence ||
+    //     bot->GetLevel() < sPlayerbotAIConfig.equipAndSpecPersistenceLevel)
+    // {
