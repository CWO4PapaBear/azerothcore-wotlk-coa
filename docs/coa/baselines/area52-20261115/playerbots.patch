-bool PlayerbotFactory::CheckItemStats(uint8 sp, uint8 ap, uint8 tank)
-{
-    switch (bot->getClass())
-    {
-        case CLASS_PRIEST:
-        case CLASS_MAGE:
-        case CLASS_WARLOCK:
-            if (!sp || ap > sp || tank > sp)
-                return false;
-            break;
-        case CLASS_PALADIN:
-        case CLASS_WARRIOR:
-            if ((!ap && !tank) || sp > ap || sp > tank)
-                return false;
-            break;
-        case CLASS_HUNTER:
-        case CLASS_ROGUE:
-            if (!ap || sp > ap || sp > tank)
-                return false;
-            break;
-        case CLASS_DEATH_KNIGHT:
-            if ((!ap && !tank) || sp > ap || sp > tank)
-                return false;
-            break;
-    }
-
-    return sp || ap || tank;
-}
