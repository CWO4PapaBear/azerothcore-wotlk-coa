#include <cassert>
#include <initializer_list>
#include <cstdint>
using uint32 = std::uint32_t;
using HolidayIds = unsigned;
enum InventoryResult { EQUIP_ERR_OK, EQUIP_ERR_ITEM_NOT_FOUND, EQUIP_ERR_YOU_CAN_NEVER_USE_THAT_ITEM,
    EQUIP_ERR_NO_REQUIRED_PROFICIENCY, EQUIP_ERR_CANT_EQUIP_SKILL, EQUIP_ERR_CANT_EQUIP_LEVEL_I,
    EQUIP_ERR_CANT_DO_RIGHT_NOW };
constexpr int ITEM_FLAG2_FACTION_HORDE=1, ITEM_FLAG2_FACTION_ALLIANCE=2, TEAM_HORDE=1,
    TEAM_ALLIANCE=0, INVTYPE_RELIC=28, CONFIG_MAX_PLAYER_LEVEL=0;
struct ItemTemplate {
    unsigned flags=0, AllowableClass=1, AllowableRace=1, InventoryType=0,
        RequiredSkill=0, RequiredSkillRank=0, RequiredSpell=0, RequiredLevel=80, HolidayId=0;
    bool HasFlag2(unsigned flag) const { return flags & flag; }
};
struct Player {
    unsigned level=1, skill=0;
    bool learned=false;
    unsigned GetLevel() const {return level;}
    unsigned GetTeamId(bool) const {return 0;}
    unsigned getClassMask() const {return 1;}
    unsigned getRaceMask() const {return 1;}
    unsigned GetSkillValue(unsigned) const {return skill;}
    bool HasSpellOrTwin(unsigned) const {return learned;}
    InventoryResult CanUseItem(ItemTemplate const*) const;
};
namespace AscensionFreePick {bool Applies(Player const*) {return true;}}
bool IsHolidayActive(unsigned) {return false;}
struct Scripts {
    bool allow=true;
    bool OnPlayerCanUseItem(Player*, ItemTemplate const*, InventoryResult& result) {
        result=EQUIP_ERR_CANT_DO_RIGHT_NOW; return allow;
    }
} scripts;
auto sScriptMgr=&scripts;
struct World {unsigned cap=80; unsigned getIntConfig(int) {return cap;}} world;
auto sWorld=&world;
struct Options {bool prestige=false;};
@USE@
@CAP@
bool Reward(Player* player, ItemTemplate const* item, Options options={}) {
    struct {bool usable=false;} candidate;
    @REQUIREMENTS@
    return candidate.usable;
}
int main() {
    Player p;
    ItemTemplate item;
    for (unsigned cap : {60u,70u,80u}) {
        world.cap=cap; item.RequiredLevel=cap;
        for (unsigned level : {1u,59u,60u,69u,70u,79u,80u}) {
            p.level=level;
            assert(RewardCap(&p,{})==cap);
            assert(Reward(&p,&item));
            assert(item.RequiredLevel==cap);
            assert((p.CanUseItem(&item)==EQUIP_ERR_OK)==(level>=cap));
            assert(Reward(&p,&item,{true})==(level>=cap));
        }
    }
    p.level=1;
    item.flags=1; assert(!Reward(&p,&item)); item.flags=0;
    item.AllowableClass=2; assert(!Reward(&p,&item)); item.AllowableClass=1;
    item.AllowableRace=2; assert(!Reward(&p,&item)); item.AllowableRace=1;
    item.RequiredSkill=1; item.RequiredSkillRank=5; assert(!Reward(&p,&item));
    p.skill=4; assert(!Reward(&p,&item)); p.skill=5; assert(Reward(&p,&item));
    item.RequiredSpell=1; assert(!Reward(&p,&item)); p.learned=true; assert(Reward(&p,&item));
    item.HolidayId=1; assert(!Reward(&p,&item)); item.HolidayId=0;
    scripts.allow=false; assert(!Reward(&p,&item));
}
